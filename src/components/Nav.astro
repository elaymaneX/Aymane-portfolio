---
import { locales, localePath, t, unlocalizedPath, type Lang } from '../i18n';

interface Props { activePage?: string; lang: Lang }
const { activePage = '', lang } = Astro.props;
const ui = t(lang).nav;
const links = [
  { href: localePath(lang, '/projects'), key: 'Projects' },
  { href: localePath(lang, '/blog'), key: 'Blog' },
  { href: localePath(lang, '/about'), key: 'About' },
] as const;
const basePath = unlocalizedPath(Astro.url.pathname);
---

<nav class="nav">
  <div class="nav__inner container">
    <a href={localePath(lang, '/')} class="nav__logo">Aymane<span class="nav__dot">.</span></a>

    <div class="nav__links">
      {links.map(link => (
        <a href={link.href} class:list={[{ active: activePage === link.key }]}>
          {ui[link.key]}
        </a>
      ))}
      <a href="mailto:aelamra25@gmail.com" class="nav__cta">{ui.cta}</a>
    </div>

    <!-- Language switcher -->
    <div class="lang-switch" role="group" aria-label={ui.language}>
      {locales.map(l => (
        <a href={localePath(l, basePath)} hreflang={l} lang={l} data-lang={l} class:list={['lang-switch__link', { active: l === lang }]} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>
      ))}
    </div>

    <!-- Dark mode toggle -->
    <button class="theme-toggle" id="theme-toggle" aria-label={ui.toggleTheme}>
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>

    <!-- Hamburger -->
    <button class="nav__burger" id="nav-burger" aria-label={ui.menu} aria-expanded="false" aria-controls="nav-menu">
      <span></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div class="nav__menu" id="nav-menu">
    {links.map(link => (
      <a href={link.href} class:list={[{ active: activePage === link.key }]}>
        {ui[link.key]}
      </a>
    ))}
    <a href="mailto:aelamra25@gmail.com" class="nav__cta">{ui.cta}</a>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--nav-bg);
    backdrop-filter: blur(12px);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 20px;
    padding-bottom: 20px;
    position: relative;
  }
  .nav__logo {
    font-family: 'Fraunces', serif;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: var(--text);
  }
  .nav__dot { color: var(--accent); }
  .nav__links {
    display: flex;
    gap: 32px;
    align-items: center;
    font-size: 15px;
    font-weight: 500;
  }
  .nav__links a { color: var(--text-muted); transition: color 0.2s; }
  .nav__links a:hover, .nav__links a.active { color: var(--accent); }
  .nav__cta {
    background: var(--text) !important;
    color: var(--bg) !important;
    padding: 10px 24px;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 14px;
    transition: opacity 0.2s;
  }
  .nav__cta:hover { opacity: 0.85; }

  /* Theme toggle */
  .theme-toggle {
    background: none;
    border: 1.5px solid var(--border);
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--text);
    transition: border-color 0.2s;
    margin-left: 8px;
  }
  .theme-toggle:hover { border-color: var(--accent); }
  .icon-moon { display: none; }
  :global([data-theme="dark"]) .icon-sun { display: none; }
  :global([data-theme="dark"]) .icon-moon { display: block; }

  /* Hamburger */
  .nav__burger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    margin-left: 8px;
  }
  .nav__burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    position: relative;
    transition: all 0.3s;
  }
  .nav__burger span::before,
  .nav__burger span::after {
    content: '';
    position: absolute;
    width: 22px;
    height: 2px;
    background: var(--text);
    transition: all 0.3s;
  }
  .nav__burger span::before { top: -7px; }
  .nav__burger span::after { top: 7px; }

  /* Mobile menu — bubble overlay */
  .nav__menu {
    display: none;
    flex-direction: column;
    gap: 8px;
    position: absolute;
    top: calc(100% + 8px);
    right: 20px;
    background: var(--card-bg);
    border-radius: 20px;
    padding: 20px 24px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.12);
    border: 1px solid var(--border-light);
    min-width: 200px;
    z-index: 200;
  }
  .nav__menu a {
    font-size: 16px;
    font-weight: 500;
    padding: 10px 12px;
    border-radius: 12px;
    color: var(--text-muted);
    transition: background 0.2s, color 0.2s;
  }
  .nav__menu a:hover, .nav__menu a.active {
    color: var(--accent);
    background: var(--accent-light);
  }
  .nav__menu .nav__cta {
    margin-top: 8px;
    text-align: center;
    padding: 12px 24px;
  }
  .nav__menu.open { display: flex; }

  .lang-switch {
    display: flex;
    gap: 2px;
    margin-left: 12px;
    padding: 3px;
    border: 1.5px solid var(--border);
    border-radius: 9999px;
  }
  .lang-switch__link {
    font-size: 12px;
    font-weight: 600;
    padding: 4px 8px;
    border-radius: 9999px;
    color: var(--text-muted);
    letter-spacing: 0.5px;
  }
  .lang-switch__link.active { background: var(--text); color: var(--bg); }
  .lang-switch__link:not(.active):hover { color: var(--accent); }

  @media (max-width: 768px) {
    .nav__links { display: none; }
    .nav__burger { display: flex; align-items: center; }
    .lang-switch { order: 0; margin-left: auto; }
    .theme-toggle { order: 0; margin-left: 8px; margin-right: 4px; }
    .nav__burger { order: 1; }
  }
</style>

<script>
  // Remember an explicit language choice so the first-visit redirect never overrides it
  document.querySelectorAll<HTMLAnchorElement>('[data-lang]').forEach(a =>
    a.addEventListener('click', () => { try { localStorage.setItem('lang', a.dataset.lang!); } catch (e) {} })
  );

  // Hamburger toggle
  const menu = document.getElementById('nav-menu');
  const burger = document.getElementById('nav-burger');
  const setMenu = (open: boolean) => {
    menu?.classList.toggle('open', open);
    burger?.setAttribute('aria-expanded', String(open));
  };
  burger?.addEventListener('click', () => setMenu(!menu?.classList.contains('open')));
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && menu?.classList.contains('open')) {
      setMenu(false);
      burger?.focus();
    }
  });

  // Close mobile menu when resizing past breakpoint
  window.addEventListener('resize', () => {
    if (window.innerWidth > 768 && menu?.classList.contains('open')) setMenu(false);
  });

  // Dark mode toggle
  const toggle = document.getElementById('theme-toggle');
  const root = document.documentElement;

  // A manual choice wins; otherwise follow the system setting, including when it changes
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
  const saved = localStorage.getItem('theme');
  if (saved) {
    root.setAttribute('data-theme', saved);
  } else if (systemDark.matches) {
    root.setAttribute('data-theme', 'dark');
  }
  systemDark.addEventListener('change', e => {
    if (!localStorage.getItem('theme')) root.setAttribute('data-theme', e.matches ? 'dark' : 'light');
  });

  toggle?.addEventListener('click', () => {
    const current = root.getAttribute('data-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
  });
</script>
