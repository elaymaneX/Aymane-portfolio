---
// Reading progress bar along the top, a copy button on every code block in the article,
// and images that open full size when clicked
interface Props {
  copy: string;
  copied: string;
  close: string;
}

const { copy, copied, close } = Astro.props;
---

<div class="progress" aria-hidden="true"><div class="progress__bar"></div></div>

<dialog class="lightbox">
  <img class="lightbox__img" alt="" />
  <button type="button" class="lightbox__close" aria-label={close}>×</button>
</dialog>

<script define:vars={{ copy, copied }}>
  // Inline (define:vars) scripts run where they are placed, before the article: wait for the page
  const init = () => {
    const bar = document.querySelector('.progress__bar');
    const article = document.querySelector('article');
    const update = () => {
      if (!bar || !article) return;
      const rect = article.getBoundingClientRect();
      const total = rect.height - innerHeight;
      const progress = total > 0 ? Math.min(Math.max(-rect.top / total, 0), 1) : 1;
      bar.style.transform = `scaleX(${progress})`;
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();

    document.querySelectorAll('article pre').forEach(pre => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy-code';
      button.textContent = copy;
      button.addEventListener('click', async () => {
        const text = pre.querySelector('code')?.innerText ?? pre.innerText;
        try {
          await navigator.clipboard.writeText(text);
        } catch (e) {
          // Clipboard API blocked (older browsers, embedded views): fall back to a hidden selection
          const area = Object.assign(document.createElement('textarea'), { value: text });
          area.style.cssText = 'position:fixed;opacity:0';
          document.body.append(area);
          area.select();
          const ok = document.execCommand('copy');
          area.remove();
          if (!ok) return;
        }
        button.textContent = copied;
        setTimeout(() => (button.textContent = copy), 1500);
      });
      const wrapper = document.createElement('div');
      wrapper.className = 'code-block';
      pre.replaceWith(wrapper);
      wrapper.append(pre, button);
    });

    // Click (or Enter) on an image to see it full size; any click or Escape closes it
    const dialog = document.querySelector('.lightbox');
    const big = dialog?.querySelector('img');
    if (dialog && big) {
      document.querySelectorAll('article .post__content img').forEach(img => {
        img.classList.add('zoomable');
        img.tabIndex = 0;
        img.setAttribute('role', 'button');
        const open = () => {
          big.src = img.currentSrc || img.src;
          big.alt = img.alt;
          dialog.showModal();
        };
        img.addEventListener('click', open);
        img.addEventListener('keydown', e => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            open();
          }
        });
      });
      dialog.addEventListener('click', () => dialog.close());
    }
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
</script>

<style is:global>
  .progress {
    position: fixed;
    inset: 0 0 auto;
    height: 3px;
    z-index: 200;
    pointer-events: none;
  }
  .progress__bar {
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--gold));
    transform: scaleX(0);
    transform-origin: left;
  }

  .code-block { position: relative; }
  .code-block pre { padding-right: 80px; }
  .copy-code {
    position: absolute;
    top: 10px;
    right: 10px;
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 4px 10px;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .code-block:hover .copy-code,
  .copy-code:focus-visible { opacity: 1; }
  @media (hover: none) { .copy-code { opacity: 1; } }

  .zoomable { cursor: zoom-in; }
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 16px;
    border: none;
    background: transparent;
    cursor: zoom-out;
  }
  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox::backdrop {
    background: rgba(10, 12, 18, 0.85);
    backdrop-filter: blur(4px);
  }
  /* Charts are exported on white, so the enlarged image keeps a white card */
  .lightbox__img {
    max-width: min(1600px, 100%);
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    background: #fff;
    border-radius: 12px;
    padding: 10px;
  }
  .lightbox__close {
    position: fixed;
    top: 16px;
    right: 16px;
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    border: none;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
  }
  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] .lightbox__img { animation: lightboxIn 0.2s ease-out; }
  }
  @keyframes lightboxIn {
    from { opacity: 0; scale: 0.96; }
    to { opacity: 1; scale: 1; }
  }
</style>
