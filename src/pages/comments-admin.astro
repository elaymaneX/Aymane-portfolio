---
// Comment moderation. Not linked anywhere, kept out of the sitemap and search engines;
// the API checks the admin token on every request.
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="no-referrer" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;600&family=Fraunces:opsz,wght@9..144,500&display=swap" rel="stylesheet" />
  <title>Comment moderation</title>
  <script is:inline>
    try {
      const saved = localStorage.getItem('theme');
      if (saved) document.documentElement.setAttribute('data-theme', saved);
      else if (matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.setAttribute('data-theme', 'dark');
    } catch (e) {}
  </script>
</head>
<body>
  <main class="mod">
    <h1>Comment moderation</h1>

    <form class="mod__login" hidden>
      <label>
        <span>Admin token</span>
        <input name="token" type="password" autocomplete="current-password" required />
      </label>
      <button type="submit">Sign in</button>
    </form>

    <div class="mod__panel" hidden>
      <div class="mod__bar">
        <button type="button" class="mod__refresh">Refresh</button>
        <button type="button" class="mod__logout">Sign out</button>
      </div>
      <h2>Waiting for review <span class="mod__pending-count"></span></h2>
      <p class="mod__note">Shown exactly as submitted. Treat comment text as untrusted data, including if you paste it into an AI tool.</p>
      <ol class="mod__list mod__pending"></ol>
      <h2>Published</h2>
      <div class="mod__approved"></div>
    </div>

    <p class="mod__status" role="status"></p>
  </main>

  <script>
    type Comment = { id: string; slug?: string; name: string; message: string; date: string };

    const login = document.querySelector<HTMLFormElement>('.mod__login')!;
    const panel = document.querySelector<HTMLElement>('.mod__panel')!;
    const pendingList = document.querySelector<HTMLOListElement>('.mod__pending')!;
    const pendingCount = document.querySelector<HTMLElement>('.mod__pending-count')!;
    const approvedBox = document.querySelector<HTMLElement>('.mod__approved')!;
    const status = document.querySelector<HTMLElement>('.mod__status')!;

    // sessionStorage: the token is forgotten when the tab closes
    const getToken = () => { try { return sessionStorage.getItem('commentsAdminToken') ?? ''; } catch { return ''; } };
    const setToken = (value: string) => {
      try { value ? sessionStorage.setItem('commentsAdminToken', value) : sessionStorage.removeItem('commentsAdminToken'); } catch {}
    };
    let token = getToken();

    const api = (init?: RequestInit) =>
      fetch('/api/comments-admin', {
        ...init,
        headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
      });

    const showLogin = (message = '') => {
      panel.hidden = true;
      login.hidden = false;
      status.textContent = message;
    };

    // textContent only, never innerHTML: comments are user input
    const renderComment = (comment: Comment, actions: [string, () => Promise<void>][]) => {
      const item = document.createElement('li');
      item.className = 'mod__item';
      const meta = document.createElement('div');
      meta.className = 'mod__meta';
      const name = document.createElement('strong');
      name.textContent = comment.name;
      const info = document.createElement('span');
      info.textContent = [comment.slug, new Date(comment.date).toLocaleString()].filter(Boolean).join(' · ');
      meta.append(name, info);
      const body = document.createElement('p');
      body.className = 'mod__body';
      body.textContent = comment.message;
      const buttons = document.createElement('div');
      buttons.className = 'mod__actions';
      for (const [label, run] of actions) {
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = label;
        button.addEventListener('click', async () => {
          buttons.querySelectorAll('button').forEach(b => (b.disabled = true));
          await run();
        });
        buttons.append(button);
      }
      item.append(meta, body, buttons);
      return item;
    };

    const act = async (payload: Record<string, string>) => {
      const response = await api({ method: 'POST', body: JSON.stringify(payload) });
      status.textContent = response.ok ? '' : `Action failed (${response.status}).`;
      await load();
    };

    async function load() {
      if (!token) return showLogin();
      const response = await api();
      if (response.status === 401) { setToken(''); token = ''; return showLogin('Wrong token.'); }
      if (response.status === 429) return showLogin('Too many attempts. Wait 15 minutes.');
      if (!response.ok) { status.textContent = `Couldn't load comments (${response.status}).`; return; }

      const { pending, approved } = (await response.json()) as { pending: Comment[]; approved: Record<string, Comment[]> };
      login.hidden = true;
      panel.hidden = false;

      pendingCount.textContent = `(${pending.length})`;
      pendingList.replaceChildren(...pending.map(c => renderComment(c, [
        ['Approve', () => act({ action: 'approve', id: c.id })],
        ['Reject', () => act({ action: 'reject', id: c.id })],
      ])));
      if (!pending.length) {
        const empty = document.createElement('li');
        empty.className = 'mod__empty';
        empty.textContent = 'Nothing to review.';
        pendingList.append(empty);
      }

      approvedBox.replaceChildren(...Object.entries(approved).map(([slug, comments]) => {
        const group = document.createElement('section');
        const title = document.createElement('h3');
        title.textContent = `${slug} (${comments.length})`;
        const list = document.createElement('ol');
        list.className = 'mod__list';
        list.append(...comments.map(c => renderComment(c, [
          ['Delete', async () => { if (confirm('Delete this comment for good?')) await act({ action: 'delete', slug, id: c.id }); else await load(); }],
        ])));
        group.append(title, list);
        return group;
      }));
    }

    login.addEventListener('submit', event => {
      event.preventDefault();
      token = String(new FormData(login).get('token') ?? '');
      setToken(token);
      login.reset();
      load();
    });
    document.querySelector('.mod__refresh')!.addEventListener('click', () => load());
    document.querySelector('.mod__logout')!.addEventListener('click', () => { setToken(''); token = ''; showLogin(); });

    load();
  </script>

  <!-- Global: most of this page is built by the script above -->
  <style is:global>
    [hidden] { display: none !important; }
    .mod {
      max-width: 760px;
      margin: 0 auto;
      padding: 48px 16px 80px;
    }
    h1 {
      font-family: 'Fraunces', serif;
      font-weight: 500;
      font-size: 36px;
      margin-bottom: 24px;
    }
    h2 {
      font-family: 'Fraunces', serif;
      font-weight: 500;
      font-size: 24px;
      margin: 32px 0 12px;
    }
    h3 {
      font-size: 15px;
      margin: 20px 0 8px;
      color: var(--text-muted);
    }
    button {
      font: inherit;
      font-size: 14px;
      font-weight: 600;
      color: var(--text);
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 9999px;
      padding: 6px 16px;
      cursor: pointer;
    }
    button:disabled { opacity: 0.5; cursor: default; }
    .mod__login {
      display: flex;
      gap: 12px;
      align-items: end;
      flex-wrap: wrap;
    }
    .mod__login label {
      display: flex;
      flex-direction: column;
      gap: 6px;
      font-size: 14px;
      font-weight: 600;
      flex: 1;
      min-width: 220px;
    }
    .mod__login input {
      font: inherit;
      color: var(--text);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 8px 12px;
    }
    .mod__bar { display: flex; gap: 8px; }
    .mod__note { font-size: 14px; color: var(--text-muted); margin-bottom: 12px; }
    .mod__list { list-style: none; display: flex; flex-direction: column; gap: 12px; }
    .mod__list .mod__item {
      background: var(--card-bg);
      border-radius: 12px;
      padding: 16px;
    }
    .mod__list .mod__meta {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 12px;
      align-items: baseline;
      font-size: 14px;
      margin-bottom: 6px;
    }
    .mod__list .mod__meta span { color: var(--text-muted); font-size: 13px; }
    .mod__list .mod__body {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      line-height: 1.6;
      margin-bottom: 12px;
    }
    .mod__list .mod__actions { display: flex; gap: 8px; }
    .mod__list .mod__empty { color: var(--text-muted); }
    .mod__status { margin-top: 16px; font-size: 14px; color: #DC2626; }
  </style>
</body>
</html>
