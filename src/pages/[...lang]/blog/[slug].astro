---
import BlogPost from '../../../layouts/BlogPost.astro';
import { localizedEntries, readingMinutes } from '../../../lib/content';
import { langPaths, type Lang } from '../../../i18n';

export async function getStaticPaths() {
  const paths = [];
  for (const { params } of langPaths()) {
    const lang = (params.lang ?? 'en') as Lang;
    for (const { slug, entry, fallback } of await localizedEntries('blog', lang)) {
      paths.push({ params: { lang: params.lang, slug }, props: { entry, fallback, lang } });
    }
  }
  return paths;
}

const { slug } = Astro.params;
const { entry, fallback, lang } = Astro.props;
const { Content, headings } = await entry.render();
---

<BlogPost {...entry.data} slug={slug} minutes={readingMinutes(entry.body)} headings={headings} lang={lang} fallback={fallback}>
  <Content />
</BlogPost>
