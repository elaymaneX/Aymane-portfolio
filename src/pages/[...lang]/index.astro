---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import headshot from '../../assets/headshot.jpeg';
import upvLogo from '../../assets/logos/upv.png';
import owLogo from '../../assets/logos/oliver-wyman.png';
import amazonLogo from '../../assets/logos/amazon.svg';
import mahleLogo from '../../assets/logos/mahle-white.svg';
import { existsSync } from 'node:fs';
import ProjectIcon from '../../components/ProjectIcon.astro';
import { isApp, projectHref } from '../../lib/projects';
import { localizedEntries } from '../../lib/content';
import { formatDate, getLang, langPaths, localePath, t } from '../../i18n';

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const ui = t(lang).home;
const byDateDesc = (a, b) => b.entry.data.date.valueOf() - a.entry.data.date.valueOf();

// Featured projects first, then newest
const featuredProjects = (await localizedEntries('projects', lang))
  .sort((a, b) => Number(b.entry.data.featured) - Number(a.entry.data.featured) || byDateDesc(a, b))
  .slice(0, 3);

// The CV button appears once public/cv.pdf exists
const hasCv = existsSync('public/cv.pdf');
const companies = [
  { name: 'Amazon', logo: amazonLogo, bg: '#ffffff', pad: true },
  { name: 'Oliver Wyman', logo: owLogo },
  { name: 'UPV', logo: upvLogo },
  { name: 'MAHLE', logo: mahleLogo, bg: '#1e2a63', pad: true },
];

const latestPosts = (await localizedEntries('blog', lang))
  .sort(byDateDesc)
  .slice(0, 3);
---

<BaseLayout title={t(lang).meta.homeTitle} lang={lang}>
  <script is:inline>
    // Play the hero intro on fresh visits and reloads, not when navigating back from another page of the site; runs before the hero paints
    try {
      const nav = performance.getEntriesByType('navigation')[0];
      const fromSite = document.referrer && new URL(document.referrer).origin === location.origin;
      if (!fromSite || (nav && nav.type === 'reload')) document.documentElement.classList.add('intro');
    } catch (e) {}
  </script>

  <!-- HERO -->
  <section class="hero container">
    <div class="hero__photo">
      <Image src={headshot} alt="Aymane Elamrani" class="hero__img" widths={[360, 760]} sizes="(max-width: 768px) 180px, 380px" loading="eager" />
    </div>
    <div class="hero__text">
      <p class="hero__greeting">{ui.greeting}</p>
      <h1 class="hero__title">
        {ui.titleIntro} <span class="highlight-blue">Aymane</span>.<br/>
        {ui.titleWelcome}<br/>
        <span class="highlight-blue">{ui.titleCorner}</span> {ui.titleOfThe}<br/>
        {ui.titleInternetPrefix}<span class="highlight-gold">{ui.titleInternet}</span>.
      </h1>
      <p class="hero__subtitle">
        {ui.subtitle} <a href="mailto:aelamra25@gmail.com" class="hero__help">{ui.help}</a>
      </p>
      <div class="hero__actions">
        <a href={localePath(lang, '/projects')} class="btn btn--primary">{ui.viewProjects} <span>→</span></a>
        <a href={localePath(lang, '/blog')} class="btn btn--outline">{ui.readBlog}</a>
        {hasCv && (
          <a href="/cv.pdf" class="btn btn--ghost" download="Aymane-Elamrani-CV.pdf">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
            {ui.cv}
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- CREDIBILITY -->
  <section class="container trust" data-reveal>
    <div class="trust__companies">
      <span class="trust__label">{ui.trustLabel}</span>
      <ul class="trust__logos">
        {companies.map(c => (
          <li class="trust__company">
            <span class="trust__logo" style={c.bg && `background: ${c.bg}`}>
              <Image src={c.logo} alt="" width={64} height={64} class:list={['trust__img', { 'trust__img--pad': c.pad }]} />
            </span>
            {c.name}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FEATURED PROJECTS -->
  <section class="section container" data-reveal>
    <div class="section__header">
      <h2 class="section__title"><span class="highlight-blue">{ui.featuredA}</span> {ui.featuredB}</h2>
      <a href={localePath(lang, '/projects')} class="section__link">{ui.viewAll}</a>
    </div>
    <div class="projects-grid">
      {featuredProjects.map(({ entry }) => {
        const project = entry.data;
        const href = projectHref(entry, lang);
        // An app that isn't live yet has no destination, so its card isn't a link
        const Card = href ? 'a' : 'div';
        return (
        <Card href={href} target={href && isApp(entry) ? '_blank' : undefined} rel={href && isApp(entry) ? 'noopener noreferrer' : undefined} class="project-card">
          {project.cover
            ? <img class="project-card__cover" src={project.cover} alt="" loading="lazy" decoding="async" width="1280" height="720" />
            : <ProjectIcon icon={project.icon} bg={project.iconBg} class="project-card__icon" />}
          <h3 class="project-card__title">{project.title}</h3>
          <p class="project-card__desc">{project.excerpt}</p>
          <div class="project-card__tags">
            {project.tags.map(tag => (
              <span class:list={['tag', { 'tag--accent': tag.accent }]}>{tag.label}</span>
            ))}
          </div>
        </Card>
        );
      })}
    </div>
  </section>

  <!-- LATEST POSTS -->
  <section class="posts-section" data-reveal>
    <div class="container">
      <div class="section__header">
        <h2 class="section__title">{ui.latestA} <span class="highlight-gold">{ui.latestB}</span></h2>
        <a href={localePath(lang, '/blog')} class="section__link">{ui.allArticles}</a>
      </div>
      <div class="posts-list">
        {latestPosts.map(({ slug, entry: { data: post } }) => (
          <a href={localePath(lang, `/blog/${slug}`)} class="post-row">
            <span class="post-row__date">{formatDate(lang, post.date, { month: 'short', year: 'numeric' })}</span>
            <span class="post-row__title">{post.title}</span>
            <span class="post-row__tag" style={`background: ${post.tagColor}`}>{post.tag}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- NEWSLETTER CTA -->
  <section class="container" style="padding-top: 80px; padding-bottom: 80px;" data-reveal>
    <div class="cta-box">
      <h2 class="cta-box__title">{ui.ctaTitle}</h2>
      <p class="cta-box__desc">{ui.ctaDesc}</p>
      <div class="cta-box__form">
        <a href="/rss.xml" class="btn btn--accent">{ui.ctaRss}</a>
        <a href="mailto:aelamra25@gmail.com" class="btn btn--light">{ui.ctaEmail}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero {
    padding-top: clamp(40px, 6vw, 80px);
    padding-bottom: clamp(40px, 5vw, 60px);
    display: flex;
    align-items: center;
    gap: clamp(24px, 5vw, 80px);
    flex-wrap: wrap;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .hero__text { flex: 1 1 320px; min-width: 0; position: relative; z-index: 1; }
  .hero__greeting {
    font-size: 16px;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 16px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .hero__title {
    font-family: 'Fraunces', serif;
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -1.5px;
    margin-bottom: 24px;
  }
  .hero__subtitle {
    font-size: clamp(16px, 1.5vw, 18px);
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 480px;
    margin-bottom: 32px;
  }
  .hero__help {
    font-weight: 700;
    color: #D94040;
    text-decoration: none;
    background: rgba(217, 64, 64, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
  }
  .hero__help:hover { text-decoration: underline; text-underline-offset: 3px; }
  .hero__actions { display: flex; gap: 12px; flex-wrap: wrap; }

  .hero__photo {
    flex: 0 0 clamp(200px, 30vw, 480px);
    height: auto;
    background: none;
    border-radius: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1;
  }
  .hero__photo::before {
    content: '';
    position: absolute;
    width: 110%;
    height: 110%;
    top: -5%;
    left: -5%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(107, 80, 220, 0.25) 0%, rgba(59, 108, 244, 0.15) 40%, transparent 70%);
    filter: blur(40px);
    z-index: 0;
    animation: smokeFloat 6s ease-in-out infinite alternate;
  }
  @keyframes smokeFloat {
    0% { transform: scale(1) translate(0, 0); opacity: 0.7; }
    50% { transform: scale(1.08) translate(5px, -5px); opacity: 1; }
    100% { transform: scale(1.02) translate(-3px, 3px); opacity: 0.8; }
  }
  :root[data-theme="dark"] .hero__photo::before {
    background: radial-gradient(circle, rgba(140, 100, 255, 0.4) 0%, rgba(107, 143, 248, 0.25) 40%, transparent 70%);
    filter: blur(50px);
  }
  .hero__img {
    width: clamp(180px, 25vw, 380px);
    height: clamp(180px, 25vw, 380px);
    border-radius: 50%;
    object-fit: cover;
    object-position: center 15%;
    border: 5px solid var(--bg);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
    position: relative;
    z-index: 1;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 15px;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s;
    font-family: 'DM Sans', sans-serif;
  }
  .btn:hover { opacity: 0.85; }
  .btn--primary { background: var(--text); color: var(--bg); }
  .btn--outline { border: 1.5px solid var(--border); color: var(--text); }
  .btn--accent { background: var(--accent); color: #fff; }

  /* Section headers */
  .section { padding-top: clamp(40px, 6vw, 80px); padding-bottom: clamp(40px, 6vw, 80px); position: relative; }
  .section__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: clamp(24px, 4vw, 48px);
    flex-wrap: wrap;
    gap: 16px;
  }
  .section__title {
    font-family: 'Fraunces', serif;
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 500;
    letter-spacing: -1px;
  }
  .section__link {
    font-size: 15px;
    font-weight: 600;
    color: var(--accent);
  }

  /* Project cards */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }
  .project-card {
    background: var(--card-bg);
    border-radius: 16px;
    padding: clamp(24px, 3vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: var(--text);
    transition: transform 0.25s, box-shadow 0.25s;
  }
  a.project-card:hover {
    transform: translateY(-4px);
    color: var(--text);
    box-shadow: 0 0 0 1px var(--accent-light), 0 16px 40px -16px rgba(59, 108, 244, 0.35);
  }
  .project-card__cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 10px;
    background: var(--bg);
    box-shadow: 0 0 0 1px var(--border-light);
  }
  .project-card__icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .project-card__title {
    font-family: 'Fraunces', serif;
    font-size: 22px;
    font-weight: 500;
  }
  .project-card__desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted);
    flex: 1;
  }
  .project-card__tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .tag {
    font-size: 12px;
    padding: 4px 12px;
    background: var(--bg);
    border-radius: 9999px;
    color: var(--text-muted);
  }
  .tag--accent { background: var(--accent); color: #fff; font-weight: 600; }

  /* Posts */
  .posts-section {
    background: var(--card-bg);
    padding: clamp(40px, 6vw, 80px) 0;
  }
  .posts-list { display: flex; flex-direction: column; }
  .post-row {
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 28px 0;
    border-top: 1px solid var(--border);
    color: var(--text);
    flex-wrap: wrap;
  }
  .post-row:last-child { border-bottom: 1px solid var(--border); }
  .post-row:hover .post-row__title { color: var(--accent); }
  .post-row__date { font-size: 13px; color: var(--text-muted); font-weight: 500; min-width: 100px; }
  .post-row__title {
    font-family: 'Fraunces', serif;
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 500;
    flex: 1;
    min-width: 200px;
    transition: color 0.2s;
  }
  .post-row__tag {
    font-size: 13px;
    padding: 4px 14px;
    color: #fff;
    border-radius: 9999px;
    font-weight: 600;
  }

  /* CTA box */
  .cta-box {
    background: var(--text);
    border-radius: 24px;
    padding: clamp(32px, 5vw, 64px);
    text-align: center;
    color: var(--bg);
  }
  .cta-box__title {
    font-family: 'Fraunces', serif;
    font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 500;
    letter-spacing: -0.5px;
    margin-bottom: 16px;
  }
  .cta-box__desc {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 480px;
    margin: 0 auto 32px;
  }
  .cta-box__form {
    display: flex;
    gap: 12px;
    justify-content: center;
    max-width: 440px;
    margin: 0 auto;
    flex-wrap: wrap;
  }
  .btn--light { background: var(--bg); color: var(--text); }
  .btn--ghost { color: var(--text-muted); padding-left: 12px; padding-right: 12px; }
  .btn--ghost:hover { color: var(--accent); }

  /* In dark mode the inverted (near-white) box glared; use a lifted card with a soft glow instead */
  :global([data-theme="dark"]) .cta-box {
    background: radial-gradient(120% 140% at 50% 0%, rgba(107, 80, 220, 0.22) 0%, transparent 60%), var(--card-bg);
    border: 1px solid var(--border-light);
    color: var(--text);
  }
  :global([data-theme="dark"]) .btn--light {
    background: transparent;
    color: var(--text);
    border: 1.5px solid var(--border);
  }

  /* CREDIBILITY STRIP: centred logos that float gently, each on its own rhythm */
  .trust {
    display: flex;
    justify-content: center;
    padding-top: 36px;
    padding-bottom: 36px;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }
  .trust__companies {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }
  .trust__label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .trust__logos {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px clamp(24px, 5vw, 56px);
  }
  .trust__company {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 15px;
  }
  .trust__logo {
    width: 40px;
    height: 40px;
    border-radius: 11px;
    overflow: hidden;
    flex-shrink: 0;
    display: flex;
    box-shadow: 0 0 0 1px var(--border-light), 0 8px 20px -10px rgba(59, 108, 244, 0.45);
  }
  .trust__img { width: 100%; height: 100%; object-fit: cover; }
  .trust__img--pad { object-fit: contain; padding: 5px; }
  @media (prefers-reduced-motion: no-preference) {
    .trust__company { animation: logoFloat 4.5s ease-in-out infinite alternate; }
    .trust__company:nth-child(2) { animation-duration: 5.2s; animation-delay: -1.8s; }
    .trust__company:nth-child(3) { animation-duration: 4.8s; animation-delay: -3.1s; }
    .trust__company:nth-child(4) { animation-duration: 5.6s; animation-delay: -0.9s; }
  }
  @keyframes logoFloat {
    from { translate: 0 -5px; }
    to { translate: 0 5px; }
  }

  /* Hero intro: photo drops in from the right, text follows (Greek letters: GreekBackground.astro) */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.intro) .hero__photo { animation: photoIn 0.9s cubic-bezier(0.22, 1.25, 0.36, 1) 0.1s both; }
    :global(html.intro) .hero__greeting { animation: slideIn 0.6s ease-out 0.45s both; }
    :global(html.intro) .hero__title { animation: slideIn 0.7s ease-out 0.6s both; }
    :global(html.intro) .hero__subtitle { animation: fadeUp 0.6s ease-out 0.95s both; }
    :global(html.intro) .hero__actions { animation: fadeUp 0.6s ease-out 1.1s both; }
  }
  @keyframes photoIn {
    from { opacity: 0; translate: 45vw -40px; rotate: 10deg; }
  }
  @keyframes slideIn {
    from { opacity: 0; translate: 48px 0; }
  }
  @keyframes fadeUp {
    from { opacity: 0; translate: 0 16px; }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .hero {
      flex-direction: column;
    }
    .hero__photo {
      order: -1;
      flex: 0 0 auto;
    }
    .hero__text { text-align: center; }
    .hero__actions { justify-content: center; }
    .post-row__title { min-width: 0; }
  }
</style>
