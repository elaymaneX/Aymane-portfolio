---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import aboutPhoto from '../../assets/about.jpeg';
import upvLogo from '../../assets/logos/upv.png';
import owLogo from '../../assets/logos/oliver-wyman.png';
import amazonLogo from '../../assets/logos/amazon.svg';
import mahleLogo from '../../assets/logos/mahle-white.svg';
import { about } from '../../i18n/about';
import { getLang, langPaths } from '../../i18n';

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const copy = about[lang];

// Language-independent parts; text (role, period, bullets...) comes from i18n/about.ts by position
const experience = [
  { company: 'CVBLabs, UPV', logo: { src: upvLogo, alt: 'UPV' } },
  { company: 'Oliver Wyman, HackatOW', logo: { src: owLogo, alt: 'Oliver Wyman' } },
  { company: 'Amazon', logo: { src: amazonLogo, alt: 'Amazon', bg: '#ffffff', pad: true } },
  { company: 'MAHLE Electronics', logo: { src: mahleLogo, alt: 'MAHLE', bg: '#1e2a63', pad: true } },
].map((e, i) => ({ ...e, ...copy.experience[i] }));

const education = copy.education.map(ed => ({ ...ed, institution: 'Universitat Politècnica de València (UPV)' }));

// Bar lengths follow the levels: native, French C1, Spanish bilingual, English C1/C2
const languages = [
  { percent: 100 },
  { percent: 85 },
  { percent: 95 },
  { percent: 90 },
].map((l, i) => ({ ...l, ...copy.languages[i] }));

const skillGroups = [
  ['Python', 'Java', 'SQL', 'C', 'C++', 'MATLAB'],
  ['PyTorch', 'JAX', 'TensorFlow', 'Scikit-learn', 'XGBoost', 'LangChain', 'Anthropic API'],
  ['FastAPI', 'Node.js', 'Spring', 'REST APIs'],
  ['Astro', 'React', 'TypeScript', 'HTML/CSS'],
  ['Pandas', 'NumPy', 'Redshift', 'Power BI', 'Tableau', 'QuickSight'],
  ['Docker', 'Kubernetes', 'GCP', 'AWS', 'CI/CD', 'Git'],
].map((items, i) => ({ label: copy.skillLabels[i], items }));

---

<BaseLayout title={copy.title} activePage="About" lang={lang}>
  <!-- HERO -->
  <section class="container about-hero">
    <div class="about-photo-col">
      <div class="about-photo-frame">
        <Image src={aboutPhoto} alt={copy.photoAlt} class="about-photo duotone" widths={[400, 800]} sizes="(max-width: 768px) 100vw, 400px" loading="eager" />
      </div>
    </div>
    <div class="about-text-col">
      <p class="about-label eyebrow">{copy.label}</p>
      <h1 class="about-title">{copy.heading} <span class="highlight-blue">Aymane</span></h1>
      <div class="about-bio">
        {copy.bio.map(par => <p>{par}</p>)}
        <p><a href="mailto:aelamra25@gmail.com" class="help-link">{copy.help}</a></p>
      </div>
    </div>
  </section>

  <!-- EXPERIENCE -->
  <section class="container about-section">
    <h2 class="section-heading">{copy.experienceHeading}</h2>
    <div class="timeline">
      {experience.map((exp) => (
        <div class="timeline-item">
          <div class="timeline-logo duotone" style={exp.logo.bg && `background: ${exp.logo.bg}`}>
            <Image src={exp.logo.src} alt={exp.logo.alt} width={112} height={112} class:list={['timeline-logo__img', { 'timeline-logo__img--pad': exp.logo.pad }]} />
          </div>
          <div class="timeline-content">
            <div class="timeline-header">
              <div>
                <h3 class="timeline-role">{exp.role}</h3>
                <p class="timeline-company">{exp.company}</p>
              </div>
              <span class="timeline-period">{exp.period}</span>
            </div>
            <ul class="timeline-bullets">
              {exp.bullets.map(b => <li>{b}</li>)}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- EDUCATION -->
  <section class="container about-section">
    <h2 class="section-heading">{copy.educationHeading}</h2>
    <div class="edu-grid">
      {education.map(ed => (
        <div class="edu-card">
          <div class="edu-card__top">
            <h3 class="edu-degree">{ed.degree}</h3>
            <span class="edu-period">{ed.period}</span>
          </div>
          <p class="edu-institution">{ed.institution}</p>
          <p class="edu-grade">{copy.gradeLabel}: {ed.grade}</p>
          <p class="edu-detail">{ed.detail}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- SKILLS -->
  <section class="container about-section">
    <h2 class="section-heading">{copy.skillsHeading}</h2>
    <div class="skills-grid">
      {skillGroups.map(group => (
        <div class="skill-group">
          <h3 class="skill-group__label">{group.label}</h3>
          <div class="skill-tags">
            {group.items.map(item => (
              <span class="skill-tag">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- LANGUAGES -->
  <section class="container about-section">
    <h2 class="section-heading">{copy.languagesHeading}</h2>
    <div class="languages-grid">
      {languages.map(spoken => (
        <div class="lang-card">
          <div class="lang-card__head">
            <span class="lang-name">{spoken.name}</span>
            <span class="lang-level">{spoken.level}</span>
          </div>
          <div class="lang-bar">
            <div class="lang-bar__fill" style={`width: ${spoken.percent}%`}></div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- INTERESTS -->
  <section class="container about-section">
    <h2 class="section-heading">{copy.interestsHeading}</h2>
    <div class="interests-grid">
      {copy.interests.map((item, i) => (
        <div class="interest">
          <span class="interest-num">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <strong>{item.title}</strong>
            <p>{item.text}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="container cta-section">
    <div class="cta-box">
      <h2 class="cta-box__title">{copy.ctaTitle}</h2>
      <p class="cta-box__desc">{copy.ctaDesc}</p>
      <a href="mailto:aelamra25@gmail.com" class="btn btn--light">{copy.ctaButton}</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .about-hero {
    padding-top: clamp(40px, 6vw, 80px);
    padding-bottom: clamp(40px, 5vw, 60px);
    display: flex;
    gap: clamp(32px, 5vw, 64px);
    align-items: flex-start;
    flex-wrap: wrap;
    justify-content: center;
  }
  .about-photo-col { flex: 0 0 clamp(220px, 28vw, 360px); }
  .about-photo-frame {
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 3 / 4;
  }
  .about-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about-text-col { flex: 1 1 320px; min-width: 0; }
  .about-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }
  .about-title {
    font-family: 'Fraunces', serif;
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
  }
  .about-bio p {
    font-size: 16px;
    line-height: 1.8;
    color: var(--text-muted);
    margin-bottom: 16px;
  }
  .help-link {
    color: var(--text);
    font-weight: 600;
    font-size: 16px;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .help-link:hover { opacity: 0.8; }

  /* SECTIONS */
  .about-section {
    padding-bottom: clamp(48px, 6vw, 80px);
  }
  .section-heading {
    font-family: 'Fraunces', serif;
    font-size: clamp(30px, 3.6vw, 44px);
    font-weight: 400;
    margin-bottom: clamp(24px, 3vw, 40px);
    letter-spacing: -0.03em;
  }

  /* TIMELINE */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
    padding-left: 72px;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 28px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--border-light);
  }
  .timeline-item {
    position: relative;
    padding-bottom: 40px;
  }
  .timeline-item:last-child { padding-bottom: 0; }
  .timeline-logo {
    position: absolute;
    left: -72px;
    top: 0;
    width: 56px;
    height: 56px;
    border-radius: var(--radius);
    background: var(--card-bg);
    border: 1px solid var(--border-light);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
    overflow: hidden;
  }
  .timeline-logo__img { width: 100%; height: 100%; object-fit: cover; }
  .timeline-logo__img--pad { object-fit: contain; padding: 9px; }
  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }
  .timeline-role {
    font-family: 'Fraunces', serif;
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 400;
    letter-spacing: -0.3px;
  }
  .timeline-company {
    font-size: 14px;
    color: var(--text-muted);
    font-weight: 500;
    margin-top: 2px;
  }
  .timeline-period {
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 3px 10px;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .timeline-bullets {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .timeline-bullets li {
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-muted);
    padding-left: 16px;
    position: relative;
  }
  .timeline-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 11px;
    width: 8px;
    height: 1px;
    background: var(--text-muted);
  }

  /* EDUCATION */
  .edu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
  }
  .edu-card {
    background: var(--bg);
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    padding: clamp(24px, 3vw, 32px);
  }
  .edu-card__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }
  .edu-degree {
    font-family: 'Fraunces', serif;
    font-size: clamp(17px, 1.8vw, 20px);
    font-weight: 400;
  }
  .edu-period {
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 3px 10px;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .edu-institution {
    font-size: 14px;
    color: var(--text);
    font-weight: 600;
    margin-bottom: 8px;
  }
  .edu-grade {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 8px;
  }
  .edu-detail {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* SKILLS */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }
  .skill-group {
    background: var(--bg);
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    padding: clamp(20px, 2.5vw, 28px);
  }
  .skill-group__label {
    font-family: 'Fraunces', serif;
    font-size: 16px;
    font-weight: 400;
    margin-bottom: 14px;
    font-style: italic;
    color: var(--text);
  }
  .skill-tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .skill-tag {
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
  }

  /* LANGUAGES */
  .languages-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
  }
  .lang-card {
    background: var(--bg);
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    padding: clamp(20px, 2.5vw, 28px);
  }
  .lang-card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }
  .lang-name {
    font-family: 'Fraunces', serif;
    font-size: 20px;
    font-weight: 400;
  }
  .lang-level {
    font-size: 13px;
    color: var(--text-muted);
  }
  .lang-bar {
    height: 2px;
    background: var(--border-light);
    overflow: hidden;
  }
  .lang-bar__fill {
    height: 100%;
    background: var(--text);
    transition: width 0.6s ease;
  }

  /* INTERESTS */
  .interests-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
  }
  .interest {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    background: var(--bg);
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    padding: clamp(20px, 2.5vw, 28px);
  }
  /* Numbered like the cards on the home page */
  .interest-num {
    flex-shrink: 0;
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-weight: 300;
    font-size: 15px;
    color: var(--text-muted);
    padding-top: 3px;
  }
  .interest strong {
    display: block;
    margin-bottom: 6px;
    font-family: 'Fraunces', serif;
    font-size: 20px;
    font-weight: 400;
  }
  .interest p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* CTA */
  .cta-section { padding-bottom: clamp(40px, 6vw, 80px); }
  .cta-box {
    background: var(--text);
    border-radius: var(--radius);
    padding: clamp(32px, 5vw, 64px);
    text-align: center;
    color: var(--bg);
  }
  .cta-box__title {
    font-family: 'Fraunces', serif;
    font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 400;
    margin-bottom: 16px;
  }
  .cta-box__desc {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 480px;
    margin: 0 auto 32px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 26px;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.02em;
    border: 1px solid transparent;
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .btn--light { background: var(--bg); border-color: var(--bg); color: var(--text); }
  .btn--light:hover { opacity: 0.8; }
  /* In dark mode the box is a bordered panel, so the button inverts back */
  :global([data-theme="dark"]) .cta-box { background: var(--bg); border: 1px solid var(--border); color: var(--text); }
  :global([data-theme="dark"]) .btn--light { background: var(--text); border-color: var(--text); color: var(--bg); }

  /* MOBILE */
  @media (max-width: 768px) {
    .about-hero {
      flex-direction: column;
    }
    .about-photo-col { max-width: 280px; margin: 0 auto; }
    .about-text-col { text-align: center; }
    .about-label { justify-content: center; }

    .timeline {
      padding-left: 0;
    }
    .timeline::before { display: none; }
    .timeline-logo {
      position: static;
      margin-bottom: 16px;
    }
    .timeline-header {
      flex-direction: column;
    }
  }
</style>
