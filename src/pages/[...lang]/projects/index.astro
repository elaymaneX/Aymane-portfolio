---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectIcon from '../../../components/ProjectIcon.astro';
import { isApp, projectHref } from '../../../lib/projects';
import { localizedEntries } from '../../../lib/content';
import { getLang, langPaths, t } from '../../../i18n';

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const ui = t(lang).projects;
const projects = (await localizedEntries('projects', lang))
  .sort((a, b) => b.entry.data.date.valueOf() - a.entry.data.date.valueOf())
  .map(p => p.entry);

const featured = projects.filter(p => p.data.featured);
const regular = projects.filter(p => !p.data.featured);
const sections = [
  { title: ui.analysisTitle, desc: ui.analysisDesc, items: regular.filter(p => !isApp(p)) },
  { title: ui.appsTitle, desc: ui.appsDesc, items: regular.filter(isApp) },
].filter(s => s.items.length);

// Cards without a destination (an app that isn't live yet) render as plain, non-clickable cards
const cardTag = (p) => projectHref(p, lang) ? 'a' : 'div';
const linkAttrs = (p) => {
  const href = projectHref(p, lang);
  if (!href) return {};
  return isApp(p) ? { href, target: '_blank', rel: 'noopener noreferrer' } : { href };
};
---

<BaseLayout title={ui.title} activePage="Projects" lang={lang}>
  <section class="container page-header">
    <p class="page-header__label eyebrow">{ui.label}</p>
    <h1 class="page-header__title">{ui.headingA} <span class="highlight-blue">{ui.headingB}</span></h1>
    <p class="page-header__desc">{ui.desc}</p>
  </section>

  <!-- Featured Projects: inside the container so they line up with the grid, as wide as two cards -->
  <section class="container">
  <h2 class="projects-section__title">{ui.analysisTitle}</h2>
  <p class="projects-section__desc">{ui.analysisDesc}</p>
  {featured.map(project => {
    const Card = cardTag(project);
    return (
    <Card {...linkAttrs(project)} class="featured-card">
      {project.data.cover && <img class="featured-card__cover" src={project.data.cover} alt="" decoding="async" width="1280" height="720" />}
      <div class="featured-card__header">
        {!project.data.cover && <ProjectIcon icon={project.data.icon} bg={project.data.iconBg} class="featured-card__icon" />}
        <div>
          <div class="featured-card__tags">
            {project.data.tags.map(tag => (
              <span class:list={['tag', { 'tag--accent': tag.accent }]}>{tag.label}</span>
            ))}
          </div>
          <h2 class="featured-card__title">{project.data.title}</h2>
        </div>
      </div>
      <p class="featured-card__desc">{project.data.excerpt}</p>
      {projectHref(project, lang) && <span class="featured-card__link">{isApp(project) ? ui.visitSite : ui.readMore}</span>}
    </Card>
    );
  })}
  </section>

  {sections.map(section => (
    <section class="container projects-section">
      {section.title !== ui.analysisTitle && <h2 class="projects-section__title">{section.title}</h2>}
      {section.title !== ui.analysisTitle && <p class="projects-section__desc">{section.desc}</p>}
      <div class="projects-grid">
        {section.items.map(project => {
          const Card = cardTag(project);
          return (
          <Card {...linkAttrs(project)} class="project-card">
            {project.data.cover
              ? <img class="project-card__cover" src={project.data.cover} alt="" loading="lazy" decoding="async" width="1280" height="720" />
              : <ProjectIcon icon={project.data.icon} bg={project.data.iconBg} class="project-card__icon" />}
            <h3 class="project-card__title">{project.data.title}</h3>
            <p class="project-card__desc">{project.data.excerpt}</p>
            <div class="project-card__tags">
              {project.data.tags.map(tag => (
                <span class:list={['tag', { 'tag--accent': tag.accent }]}>{tag.label}</span>
              ))}
            </div>
            {projectHref(project, lang) && <span class="project-card__link">{isApp(project) ? ui.visitSite : ui.readMore}</span>}
          </Card>
          );
        })}
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .page-header {
    padding-top: clamp(40px, 6vw, 80px);
    padding-bottom: clamp(40px, 5vw, 60px);
  }
  .page-header__label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }
  .page-header__title {
    font-family: 'Fraunces', serif;
    font-size: clamp(44px, 6vw, 76px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 20px;
  }
  .page-header__desc {
    font-size: clamp(16px, 1.5vw, 18px);
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 560px;
  }

  /* Featured Card */
  .featured-card {
    display: block;
    background: var(--bg);
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    padding: clamp(28px, 4vw, 48px);
    margin-bottom: 32px;
    color: var(--text);
    transition: border-color 0.2s, translate 0.2s;
  }
  .featured-card__cover,
  .project-card__cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--bg);
    box-shadow: 0 0 0 1px var(--border-light);
  }
  /* The featured card spans two columns: a wider crop keeps the cover from towering */
  .featured-card__cover { aspect-ratio: 21 / 9; margin-bottom: 28px; }
  a.featured-card:hover {
    translate: 0 -2px;
    border-color: var(--text);
  }
  .featured-card__header {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    margin-bottom: 20px;
  }
  .featured-card__icon {
    width: 52px;
    height: 52px;
    min-width: 52px;
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .featured-card__tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .featured-card__title {
    font-family: 'Fraunces', serif;
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 400;
    letter-spacing: -1px;
  }
  .featured-card__desc {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-muted);
    margin-bottom: 16px;
    max-width: 720px;
  }
  .featured-card__link {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text);
  }

  /* Project sections */
  .projects-section { padding-bottom: clamp(40px, 6vw, 80px); }
  .projects-section__title {
    font-family: 'Fraunces', serif;
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 400;
    letter-spacing: -0.5px;
    margin-bottom: 8px;
  }
  .projects-section__desc {
    font-size: 15px;
    color: var(--text-muted);
    margin-bottom: 24px;
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  .project-card {
    background: var(--bg);
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    padding: clamp(24px, 3vw, 36px);
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: var(--text);
    transition: border-color 0.2s, translate 0.2s;
  }
  a.project-card:hover {
    translate: 0 -2px;
    border-color: var(--text);
  }
  .project-card__icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .project-card__title {
    font-family: 'Fraunces', serif;
    font-size: clamp(20px, 2vw, 24px);
    font-weight: 400;
  }
  .project-card__desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
    flex: 1;
  }
  .project-card__tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .project-card__link {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text);
    margin-top: auto;
  }
  /* Tags: small outlined labels; the lead tag is filled */
  .tag {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 9px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
  }
  .tag--accent { background: var(--text); border-color: var(--text); color: var(--bg); }

  @media (max-width: 768px) {
    .projects-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .featured-card__header { flex-direction: column; }
  }
</style>
