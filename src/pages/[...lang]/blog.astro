---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localizedEntries } from '../../lib/content';
import { formatDate, getLang, langPaths, localePath, t } from '../../i18n';

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const ui = t(lang).blog;
const posts = (await localizedEntries('blog', lang))
  .sort((a, b) => b.entry.data.date.valueOf() - a.entry.data.date.valueOf());
---

<BaseLayout title={ui.title} activePage="Blog" lang={lang}>
  <section class="container page-header">
    <p class="page-header__label eyebrow">{ui.label}</p>
    <h1 class="page-header__title">{ui.headingA} <span class="highlight-gold">{ui.headingB}</span></h1>
    <p class="page-header__desc">{ui.desc}</p>
  </section>

  <section class="container posts">
    {posts.map(({ slug, entry: { data: post }, fallback }) => (
      <a href={localePath(lang, `/blog/${slug}`)} class="post-card" lang={fallback ? 'en' : undefined}>
        <div class="post-card__meta">
          <span class="post-card__date">{formatDate(lang, post.date, { year: 'numeric', month: 'short', day: 'numeric' })}</span>
          <span class="post-card__tag">{post.tag}</span>
          {fallback && <span class="post-card__lang" title={t(lang).onlyInEnglish}>EN</span>}
        </div>
        <h2 class="post-card__title">{post.title}</h2>
        <p class="post-card__excerpt">{post.excerpt}</p>
        <span class="post-card__link">{ui.readMore}</span>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .post-card__lang {
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    color: var(--text-muted);
  }
  .page-header {
    padding-top: clamp(40px, 6vw, 80px);
    padding-bottom: clamp(40px, 5vw, 60px);
  }
  .page-header__label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }
  .page-header__title {
    font-family: 'Fraunces', serif;
    font-size: clamp(44px, 6vw, 76px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 20px;
  }
  .page-header__desc {
    font-size: clamp(16px, 1.5vw, 18px);
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 560px;
  }

  .posts {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-bottom: clamp(40px, 6vw, 80px);
  }
  .post-card {
    background: var(--bg);
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    padding: clamp(24px, 3.5vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: var(--text);
    transition: border-color 0.2s, translate 0.2s;
  }
  .post-card:hover {
    translate: 0 -2px;
    border-color: var(--text);
  }
  .post-card__meta { display: flex; align-items: center; gap: 12px; }
  .post-card__date { font-size: 13px; color: var(--text-muted); font-weight: 500; }
  .post-card__tag {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px 9px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
  }
  .post-card__title {
    font-family: 'Fraunces', serif;
    font-size: clamp(20px, 2.5vw, 28px);
    font-weight: 400;
    letter-spacing: -0.5px;
  }
  .post-card__excerpt {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 640px;
  }
  .post-card__link {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text);
    margin-top: 4px;
  }
</style>
