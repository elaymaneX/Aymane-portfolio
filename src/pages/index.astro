---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import headshot from '../assets/headshot.jpeg';
import { isApp, projectHref } from '../lib/projects';

const byDateDesc = (a, b) => b.data.date.valueOf() - a.data.date.valueOf();

// Featured projects first, then newest
const featuredProjects = (await getCollection('projects', p => !p.data.draft))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || byDateDesc(a, b))
  .slice(0, 3);

const latestPosts = (await getCollection('blog', p => !p.data.draft))
  .sort(byDateDesc)
  .slice(0, 3);
---

<BaseLayout title="Aymane Elamrani | ML Engineer & Maker">
  <script is:inline>
    // Play the hero intro on the first homepage view of each visit; runs before the hero paints
    try {
      if (!sessionStorage.getItem('introSeen')) {
        document.documentElement.classList.add('intro');
        sessionStorage.setItem('introSeen', '1');
      }
    } catch (e) {}
  </script>

  <!-- HERO -->
  <section class="hero container">
    <div class="hero__greek" aria-hidden="true">
      <span class="greek greek--1">Σ</span>
      <span class="greek greek--2">Δ</span>
      <span class="greek greek--3">Ψ</span>
      <span class="greek greek--4">∂</span>
      <span class="greek greek--5">λ</span>
      <span class="greek greek--6">π</span>
    </div>
    <div class="hero__photo">
      <Image src={headshot} alt="Aymane Elamrani" class="hero__img" widths={[360, 760]} sizes="(max-width: 768px) 180px, 380px" loading="eager" />
    </div>
    <div class="hero__text">
      <p class="hero__greeting">Hey there,</p>
      <h1 class="hero__title">
        I'm <span class="highlight-blue">Aymane</span>.<br/>
        Welcome to my<br/>
        <span class="highlight-blue">corner</span> of the<br/>
        <span class="highlight-gold">internet</span>.
      </h1>
      <p class="hero__subtitle">
        ML engineer with a quantum physics background. I went from studying how photons behave to building forecasting systems at Amazon, and now I'm carving my way into quantitative finance and AI agents. I like hard problems, messy data, and first-principles thinking. <a href="mailto:aelamra25@gmail.com" class="hero__help">How can I help you?</a>
      </p>
      <div class="hero__actions">
        <a href="/projects" class="btn btn--primary">View projects <span>→</span></a>
        <a href="/blog" class="btn btn--outline">Read the blog</a>
      </div>
    </div>
  </section>

  <!-- FEATURED PROJECTS -->
  <section class="section container">
    <div class="section__header">
      <h2 class="section__title"><span class="highlight-blue">Featured</span> Projects</h2>
      <a href="/projects" class="section__link">View all →</a>
    </div>
    <div class="projects-grid">
      {featuredProjects.map(entry => {
        const project = entry.data;
        const stroke = project.iconBg === '#F5C563' ? '#111827' : '#fff';
        return (
        <a href={projectHref(entry)} target={isApp(entry) ? '_blank' : undefined} rel={isApp(entry) ? 'noopener noreferrer' : undefined} class="project-card">
          <div class="project-card__icon" style={`background: ${project.iconBg}`}>
            {project.icon === 'automation' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke={stroke} stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12V7H5a2 2 0 010-4h14v4"/><path d="M3 5v14a2 2 0 002 2h16v-5"/><path d="M18 12a2 2 0 000 4h4v-4h-4z"/></svg>
            )}
            {project.icon === 'signal' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke={stroke} stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            )}
            {project.icon === 'web' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke={stroke} stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
            )}
            {project.icon === 'code' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke={stroke} stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            )}
          </div>
          <h3 class="project-card__title">{project.title}</h3>
          <p class="project-card__desc">{project.excerpt}</p>
          <div class="project-card__tags">
            {project.tags.map(tag => (
              <span class:list={['tag', { 'tag--accent': tag.accent }]}>{tag.label}</span>
            ))}
          </div>
        </a>
        );
      })}
    </div>
  </section>

  <!-- LATEST POSTS -->
  <section class="posts-section">
    <div class="container">
      <div class="section__header">
        <h2 class="section__title">Latest from the <span class="highlight-gold">Blog</span></h2>
        <a href="/blog" class="section__link">All articles →</a>
      </div>
      <div class="posts-list">
        {latestPosts.map(({ slug, data: post }) => (
          <a href={`/blog/${slug}`} class="post-row">
            <span class="post-row__date">{post.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })}</span>
            <span class="post-row__title">{post.title}</span>
            <span class="post-row__tag" style={`background: ${post.tagColor}`}>{post.tag}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- NEWSLETTER CTA -->
  <section class="container" style="padding-top: 80px; padding-bottom: 80px;">
    <div class="cta-box">
      <h2 class="cta-box__title">Stay in the loop</h2>
      <p class="cta-box__desc">I share new projects, analysis write-ups, and thoughts on AI and finance. Follow along with RSS, or just say hi.</p>
      <div class="cta-box__form">
        <a href="/rss.xml" class="btn btn--accent">Subscribe via RSS</a>
        <a href="mailto:aelamra25@gmail.com" class="btn btn--light">Email me</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero {
    padding-top: clamp(40px, 6vw, 80px);
    padding-bottom: clamp(40px, 5vw, 60px);
    display: flex;
    align-items: center;
    gap: clamp(24px, 5vw, 80px);
    flex-wrap: wrap;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  /* Greek letter decorations */
  .hero__greek { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
  .greek {
    position: absolute;
    font-family: 'Fraunces', serif;
    color: var(--accent);
    opacity: 0.06;
    font-weight: 400;
    line-height: 1;
  }
  .greek--1 { font-size: 180px; top: -20px; right: 5%; }
  .greek--2 { font-size: 120px; bottom: 10%; left: 2%; }
  .greek--3 { font-size: 140px; top: 15%; left: 15%; }
  .greek--4 { font-size: 100px; bottom: 5%; right: 20%; }
  .greek--5 { font-size: 160px; top: 40%; right: -2%; }
  .greek--6 { font-size: 90px; top: 5%; left: 40%; }
  .hero__text { flex: 1 1 320px; min-width: 0; position: relative; z-index: 1; }
  .hero__greeting {
    font-size: 16px;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 16px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .hero__title {
    font-family: 'Fraunces', serif;
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -1.5px;
    margin-bottom: 24px;
  }
  .hero__subtitle {
    font-size: clamp(16px, 1.5vw, 18px);
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 480px;
    margin-bottom: 32px;
  }
  .hero__help {
    font-weight: 700;
    color: #D94040;
    text-decoration: none;
    background: rgba(217, 64, 64, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
  }
  .hero__help:hover { text-decoration: underline; text-underline-offset: 3px; }
  .hero__actions { display: flex; gap: 12px; flex-wrap: wrap; }

  .hero__photo {
    flex: 0 0 clamp(200px, 30vw, 480px);
    height: auto;
    background: none;
    border-radius: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1;
  }
  .hero__photo::before {
    content: '';
    position: absolute;
    width: 110%;
    height: 110%;
    top: -5%;
    left: -5%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(107, 80, 220, 0.25) 0%, rgba(59, 108, 244, 0.15) 40%, transparent 70%);
    filter: blur(40px);
    z-index: 0;
    animation: smokeFloat 6s ease-in-out infinite alternate;
  }
  @keyframes smokeFloat {
    0% { transform: scale(1) translate(0, 0); opacity: 0.7; }
    50% { transform: scale(1.08) translate(5px, -5px); opacity: 1; }
    100% { transform: scale(1.02) translate(-3px, 3px); opacity: 0.8; }
  }
  :root[data-theme="dark"] .hero__photo::before {
    background: radial-gradient(circle, rgba(140, 100, 255, 0.4) 0%, rgba(107, 143, 248, 0.25) 40%, transparent 70%);
    filter: blur(50px);
  }
  .hero__img {
    width: clamp(180px, 25vw, 380px);
    height: clamp(180px, 25vw, 380px);
    border-radius: 50%;
    object-fit: cover;
    object-position: center 15%;
    border: 5px solid var(--bg);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
    position: relative;
    z-index: 1;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 15px;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s;
    font-family: 'DM Sans', sans-serif;
  }
  .btn:hover { opacity: 0.85; }
  .btn--primary { background: var(--text); color: var(--bg); }
  .btn--outline { border: 1.5px solid var(--border); color: var(--text); }
  .btn--accent { background: var(--accent); color: #fff; }

  /* Section headers */
  .section { padding-top: clamp(40px, 6vw, 80px); padding-bottom: clamp(40px, 6vw, 80px); position: relative; }
  .section__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: clamp(24px, 4vw, 48px);
    flex-wrap: wrap;
    gap: 16px;
  }
  .section__title {
    font-family: 'Fraunces', serif;
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 500;
    letter-spacing: -1px;
  }
  .section__link {
    font-size: 15px;
    font-weight: 600;
    color: var(--accent);
  }

  /* Project cards */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }
  .project-card {
    background: var(--card-bg);
    border-radius: 16px;
    padding: clamp(24px, 3vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: var(--text);
    transition: transform 0.2s;
  }
  .project-card:hover { transform: translateY(-2px); color: var(--text); }
  .project-card__icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .project-card__title {
    font-family: 'Fraunces', serif;
    font-size: 22px;
    font-weight: 500;
  }
  .project-card__desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted);
    flex: 1;
  }
  .project-card__tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .tag {
    font-size: 12px;
    padding: 4px 12px;
    background: var(--bg);
    border-radius: 9999px;
    color: var(--text-muted);
  }
  .tag--accent { background: var(--accent); color: #fff; font-weight: 600; }

  /* Posts */
  .posts-section {
    background: var(--card-bg);
    padding: clamp(40px, 6vw, 80px) 0;
  }
  .posts-list { display: flex; flex-direction: column; }
  .post-row {
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 28px 0;
    border-top: 1px solid var(--border);
    color: var(--text);
    flex-wrap: wrap;
  }
  .post-row:last-child { border-bottom: 1px solid var(--border); }
  .post-row:hover .post-row__title { color: var(--accent); }
  .post-row__date { font-size: 13px; color: var(--text-muted); font-weight: 500; min-width: 100px; }
  .post-row__title {
    font-family: 'Fraunces', serif;
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 500;
    flex: 1;
    min-width: 200px;
    transition: color 0.2s;
  }
  .post-row__tag {
    font-size: 13px;
    padding: 4px 14px;
    color: #fff;
    border-radius: 9999px;
    font-weight: 600;
  }

  /* CTA box */
  .cta-box {
    background: var(--text);
    border-radius: 24px;
    padding: clamp(32px, 5vw, 64px);
    text-align: center;
    color: var(--bg);
  }
  .cta-box__title {
    font-family: 'Fraunces', serif;
    font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 500;
    letter-spacing: -0.5px;
    margin-bottom: 16px;
  }
  .cta-box__desc {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 480px;
    margin: 0 auto 32px;
  }
  .cta-box__form {
    display: flex;
    gap: 12px;
    justify-content: center;
    max-width: 440px;
    margin: 0 auto;
    flex-wrap: wrap;
  }
  .btn--light { background: var(--bg); color: var(--text); }

  /* Hero intro: Greek letters float in, photo drops in from the right, text follows */
  @media (prefers-reduced-motion: no-preference) {
    .greek { animation: greekFloat 9s ease-in-out infinite alternate; }
    .greek--2 { animation-duration: 11s; animation-delay: -3s; }
    .greek--3 { animation-duration: 8s; animation-delay: -5s; }
    .greek--4 { animation-duration: 12s; animation-delay: -2s; }
    .greek--5 { animation-duration: 10s; animation-delay: -6s; }
    .greek--6 { animation-duration: 7s; animation-delay: -4s; }

    :global(html.intro) .greek {
      animation: greekIn 1.4s ease-out both, greekFloat 9s ease-in-out 1.4s infinite alternate;
    }
    :global(html.intro) .greek--2 { animation-delay: 0.15s, 1.55s; }
    :global(html.intro) .greek--3 { animation-delay: 0.3s, 1.7s; }
    :global(html.intro) .greek--4 { animation-delay: 0.45s, 1.85s; }
    :global(html.intro) .greek--5 { animation-delay: 0.6s, 2s; }
    :global(html.intro) .greek--6 { animation-delay: 0.75s, 2.15s; }

    :global(html.intro) .hero__photo { animation: photoIn 0.9s cubic-bezier(0.22, 1.25, 0.36, 1) 0.1s both; }
    :global(html.intro) .hero__greeting { animation: slideIn 0.6s ease-out 0.45s both; }
    :global(html.intro) .hero__title { animation: slideIn 0.7s ease-out 0.6s both; }
    :global(html.intro) .hero__subtitle { animation: fadeUp 0.6s ease-out 0.95s both; }
    :global(html.intro) .hero__actions { animation: fadeUp 0.6s ease-out 1.1s both; }
  }
  @keyframes greekIn {
    from { opacity: 0; scale: 0.6; }
  }
  @keyframes greekFloat {
    from { translate: 0 0; rotate: 0deg; }
    to { translate: 12px -24px; rotate: 6deg; }
  }
  @keyframes photoIn {
    from { opacity: 0; translate: 45vw -40px; rotate: 10deg; }
  }
  @keyframes slideIn {
    from { opacity: 0; translate: 48px 0; }
  }
  @keyframes fadeUp {
    from { opacity: 0; translate: 0 16px; }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .hero {
      flex-direction: column;
    }
    .hero__photo {
      order: -1;
      flex: 0 0 auto;
    }
    .hero__text { text-align: center; }
    .hero__actions { justify-content: center; }
    .post-row__title { min-width: 0; }
  }
</style>
