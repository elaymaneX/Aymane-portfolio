---
import BaseLayout from '../layouts/BaseLayout.astro';

const otherProjects = [
  {
    title: 'Portfolio & Blog',
    description: 'This website you are looking at. Designed with Claude Design and built with Claude Code, Astro and MDX. Features dark mode, fluid responsive typography, a markdown-powered blog, and auto-deploys on Vercel.',
    tags: [{ label: 'Astro' }, { label: 'Claude' }, { label: 'Vercel' }],
    icon: 'web',
    color: '#F5C563',
  },
  {
    title: 'Control de Horas',
    description: 'Work-hours tracking app built for my father\'s masonry business. Employees log hours via a simple interface, and the system sends automated weekly summary emails to the manager with Resend. Backend powered by Supabase.',
    tags: [{ label: 'Supabase' }, { label: 'Resend' }, { label: 'TypeScript' }],
    icon: 'automation',
    color: '#111827',
  },
];

const octResults = [
  {
    src: '/images/oct/scatter-supervised.png',
    caption: 'True vs predicted scatter plots for attenuation (μ) and reflectivity (r) after supervised oracle-deconvolution training. R²≈0.97 for both parameters.',
    label: 'Supervised R²',
  },
  {
    src: '/images/oct/pinn-comparison.png',
    caption: 'Pre-PINN vs post-PINN test metrics. Reconstruction log-MSE drops 3.7× (0.89→0.24) while attenuation R² improves slightly (0.974→0.978).',
    label: 'PINN improvement',
  },
  {
    src: '/images/oct/cross-stage.png',
    caption: 'Cross-stage qualitative panel: observation, pre/post reconstructions, μ maps, and residual comparison showing reduced error after PINN fine-tuning.',
    label: 'Spatial comparison',
  },
];
---

<BaseLayout title="Projects | Aymane Elamrani" activePage="Projects">
  <section class="container page-header">
    <p class="page-header__label">Projects</p>
    <h1 class="page-header__title">Things I've <span class="highlight-blue">built</span></h1>
    <p class="page-header__desc">A mix of AI tools, automations, and research projects. Some are open-source, some are experiments, all taught me something.</p>
  </section>

  <!-- Featured: OCT Project -->
  <section class="container oct-featured">
    <div class="oct-header">
      <div class="oct-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      </div>
      <div>
        <div class="oct-tags">
          <span class="tag tag--accent">JAX</span>
          <span class="tag">Physics-ML</span>
          <span class="tag">PINN</span>
          <span class="tag">Research</span>
        </div>
        <h2 class="oct-title">OCT Reconstruction ML</h2>
        <p class="oct-subtitle">Master thesis &middot; Physics-Informed Deep Learning for Quantitative Reconstruction in Optical Coherence Tomography</p>
      </div>
    </div>

    <div class="oct-body">
      <div class="oct-description">
        <p>Built a complete physics-informed neural network pipeline for quantitative OCT image reconstruction. The system jointly recovers tissue attenuation (&mu;) and reflectivity (r) maps from synthetic confocal B-scans, constrained by a differentiable Beer-Lambert forward model.</p>

        <div class="oct-stats">
          <div class="stat">
            <span class="stat__value">R&sup2;&asymp;0.97</span>
            <span class="stat__label">Supervised recovery</span>
          </div>
          <div class="stat">
            <span class="stat__value">3.7&times;</span>
            <span class="stat__label">Reconstruction error reduction</span>
          </div>
          <div class="stat">
            <span class="stat__value">5 000</span>
            <span class="stat__label">Synthetic retinal B-scans</span>
          </div>
        </div>

        <h3>Pipeline</h3>
        <ul class="oct-pipeline">
          <li><strong>Architecture:</strong> Multi-head U-Net in JAX/Flax with separate decoder heads for &mu; and r, plus an optional PSF branch</li>
          <li><strong>Stage 1 &ndash; Supervised:</strong> Oracle-deconvolution training on synthetic data. Achieved R&sup2;&asymp;0.97 for both tissue parameters (RMSE: 0.184 for &mu;, 0.061 for r)</li>
          <li><strong>Stage 2 &ndash; PINN fine-tuning:</strong> Added a physics-informed reconstruction loss that propagates predicted maps through the forward model. Cut reconstruction log-MSE from 0.89 to 0.24 while maintaining label accuracy</li>
          <li><strong>Forward model:</strong> Differentiable Tier-1 Beer-Lambert operator with depth-dependent PSF blur, used inside the training loop</li>
          <li><strong>FDTD simulator:</strong> Built and validated a finite-difference time-domain electromagnetic simulator against analytical Mie scattering theory for future Sim2Sim transfer</li>
        </ul>
      </div>
    </div>

    <div class="oct-results">
      <h3 class="oct-results__title">Results</h3>
      <div class="oct-gallery">
        {octResults.map(fig => (
          <figure class="oct-figure">
            <img src={fig.src} alt={fig.caption} loading="lazy" />
            <figcaption>
              <strong>{fig.label}</strong>
              <span>{fig.caption}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Other Projects -->
  <section class="container projects-grid">
    {otherProjects.map(project => (
      <div class="project-card">
        <div class="project-card__icon" style={`background: ${project.color}`}>
          {project.icon === 'automation' && (
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#111827" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12V7H5a2 2 0 010-4h14v4"/><path d="M3 5v14a2 2 0 002 2h16v-5"/><path d="M18 12a2 2 0 000 4h4v-4h-4z"/></svg>
          )}
          {project.icon === 'web' && (
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
          )}
        </div>
        <h2 class="project-card__title">{project.title}</h2>
        <p class="project-card__desc">{project.description}</p>
        <div class="project-card__tags">
          {project.tags.map(tag => (
            <span class:list={['tag', { 'tag--accent': tag.accent }]}>{tag.label}</span>
          ))}
        </div>
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-top: clamp(40px, 6vw, 80px);
    padding-bottom: clamp(40px, 5vw, 60px);
  }
  .page-header__label {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 16px;
  }
  .page-header__title {
    font-family: 'Fraunces', serif;
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 500;
    letter-spacing: -1.5px;
    margin-bottom: 20px;
  }
  .page-header__desc {
    font-size: clamp(16px, 1.5vw, 18px);
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 560px;
  }

  /* OCT Featured Project */
  .oct-featured {
    background: var(--card-bg);
    border-radius: 20px;
    padding: clamp(28px, 4vw, 48px);
    margin-bottom: 32px;
  }

  .oct-header {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    margin-bottom: 32px;
  }
  .oct-icon {
    width: 52px;
    height: 52px;
    min-width: 52px;
    border-radius: 14px;
    background: #3B6CF4;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .oct-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .oct-title {
    font-family: 'Fraunces', serif;
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 500;
    letter-spacing: -1px;
    margin-bottom: 8px;
  }
  .oct-subtitle {
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .oct-body {
    margin-bottom: 36px;
  }
  .oct-description p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-muted);
    margin-bottom: 24px;
  }

  .oct-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 28px;
  }
  .stat {
    background: var(--bg);
    border-radius: 12px;
    padding: 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .stat__value {
    font-family: 'Fraunces', serif;
    font-size: clamp(22px, 2.5vw, 30px);
    font-weight: 600;
    color: var(--accent);
  }
  .stat__label {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .oct-description h3 {
    font-family: 'Fraunces', serif;
    font-size: 20px;
    font-weight: 500;
    margin-bottom: 12px;
  }
  .oct-pipeline {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .oct-pipeline li {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted);
    padding-left: 20px;
    position: relative;
  }
  .oct-pipeline li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
  .oct-pipeline li strong {
    color: var(--text);
    font-weight: 600;
  }

  /* Results Gallery */
  .oct-results {
    border-top: 1px solid var(--border-light);
    padding-top: 32px;
  }
  .oct-results__title {
    font-family: 'Fraunces', serif;
    font-size: 22px;
    font-weight: 500;
    margin-bottom: 20px;
  }
  .oct-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  .oct-figure {
    margin: 0;
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg);
  }
  .oct-figure img {
    width: 100%;
    height: auto;
    display: block;
    cursor: zoom-in;
    transition: transform 0.3s ease;
  }
  .oct-figure img:hover {
    transform: scale(1.02);
  }
  .oct-figure figcaption {
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .oct-figure figcaption strong {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
  }
  .oct-figure figcaption span {
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  /* Other Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
    padding-bottom: clamp(40px, 6vw, 80px);
  }
  .project-card {
    background: var(--card-bg);
    border-radius: 16px;
    padding: clamp(24px, 3vw, 36px);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .project-card__icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .project-card__title {
    font-family: 'Fraunces', serif;
    font-size: clamp(20px, 2vw, 24px);
    font-weight: 500;
  }
  .project-card__desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
    flex: 1;
  }
  .project-card__tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .tag {
    font-size: 12px;
    padding: 4px 12px;
    background: var(--bg);
    border-radius: 9999px;
    color: var(--text-muted);
  }
  .tag--accent { background: var(--accent); color: #fff; font-weight: 600; }

  @media (max-width: 640px) {
    .oct-header { flex-direction: column; }
    .oct-stats { grid-template-columns: 1fr; }
    .oct-gallery { grid-template-columns: 1fr; }
  }
</style>
