---
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = [
  { date: 'Oct 15, 2026', title: 'Why I Think Agentic AI Will Replace Most SaaS', tag: 'AI', tagColor: '#3B6CF4', excerpt: 'The shift from "software as a service" to "agents as a service" is closer than most founders think. Here\'s why the current SaaS model is ripe for disruption.' },
  { date: 'Sep 22, 2026', title: 'A Monte Carlo Approach to Portfolio Allocation', tag: 'Finance', tagColor: '#111827', excerpt: 'Using Monte Carlo simulations to optimize portfolio allocation across asset classes, with a focus on risk-adjusted returns and drawdown constraints.' },
  { date: 'Aug 10, 2026', title: 'Building Physics-Informed Neural Nets from Scratch', tag: 'Research', tagColor: '#6B7280', excerpt: 'A walkthrough of implementing PINNs in JAX — encoding PDEs as loss functions, training tricks, and why they matter for scientific computing.' },
];
---

<BaseLayout title="Blog — Aymane Elamrani" activePage="Blog">
  <section class="container page-header">
    <p class="page-header__label">Blog</p>
    <h1 class="page-header__title">Thoughts & <span class="highlight-gold">write-ups</span></h1>
    <p class="page-header__desc">I write about AI, quantitative finance, and the things I build. Long-form takes, tutorials, and the occasional rant.</p>
  </section>

  <section class="container posts">
    {posts.map(post => (
      <article class="post-card">
        <div class="post-card__meta">
          <span class="post-card__date">{post.date}</span>
          <span class="post-card__tag" style={`background: ${post.tagColor}`}>{post.tag}</span>
        </div>
        <h2 class="post-card__title">{post.title}</h2>
        <p class="post-card__excerpt">{post.excerpt}</p>
        <span class="post-card__link">Read more →</span>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-top: 80px;
    padding-bottom: 60px;
  }
  .page-header__label {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 16px;
  }
  .page-header__title {
    font-family: 'Fraunces', serif;
    font-size: 56px;
    font-weight: 500;
    letter-spacing: -1.5px;
    margin-bottom: 20px;
  }
  .page-header__desc {
    font-size: 18px;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 560px;
  }

  .posts {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-bottom: 80px;
  }
  .post-card {
    background: var(--card-bg);
    border-radius: 16px;
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .post-card__meta { display: flex; align-items: center; gap: 12px; }
  .post-card__date { font-size: 13px; color: var(--text-muted); font-weight: 500; }
  .post-card__tag {
    font-size: 12px;
    padding: 3px 12px;
    color: #fff;
    border-radius: 9999px;
    font-weight: 600;
  }
  .post-card__title {
    font-family: 'Fraunces', serif;
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.5px;
  }
  .post-card__excerpt {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 640px;
  }
  .post-card__link {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    margin-top: 4px;
  }

  @media (max-width: 768px) {
    .page-header { padding-top: 40px; }
    .page-header__title { font-size: 36px; }
    .post-card { padding: 28px; }
    .post-card__title { font-size: 22px; }
  }
</style>
