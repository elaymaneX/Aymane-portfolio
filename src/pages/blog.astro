---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog | Aymane Elamrani" activePage="Blog">
  <section class="container page-header">
    <p class="page-header__label">Blog</p>
    <h1 class="page-header__title">Thoughts & <span class="highlight-gold">write-ups</span></h1>
    <p class="page-header__desc">I write about AI, quantitative finance, and the things I build. Long-form takes, tutorials, and the occasional rant.</p>
  </section>

  <section class="container posts">
    {posts.map(post => (
      <a href={`/blog/${post.slug}`} class="post-card">
        <div class="post-card__meta">
          <span class="post-card__date">{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
          <span class="post-card__tag" style={`background: ${post.data.tagColor}`}>{post.data.tag}</span>
        </div>
        <h2 class="post-card__title">{post.data.title}</h2>
        <p class="post-card__excerpt">{post.data.excerpt}</p>
        <span class="post-card__link">Read more →</span>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-top: clamp(40px, 6vw, 80px);
    padding-bottom: clamp(40px, 5vw, 60px);
  }
  .page-header__label {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 16px;
  }
  .page-header__title {
    font-family: 'Fraunces', serif;
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 500;
    letter-spacing: -1.5px;
    margin-bottom: 20px;
  }
  .page-header__desc {
    font-size: clamp(16px, 1.5vw, 18px);
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 560px;
  }

  .posts {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-bottom: clamp(40px, 6vw, 80px);
  }
  .post-card {
    background: var(--card-bg);
    border-radius: 16px;
    padding: clamp(24px, 3.5vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: var(--text);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .post-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
  }
  .post-card__meta { display: flex; align-items: center; gap: 12px; }
  .post-card__date { font-size: 13px; color: var(--text-muted); font-weight: 500; }
  .post-card__tag {
    font-size: 12px;
    padding: 3px 12px;
    color: #fff;
    border-radius: 9999px;
    font-weight: 600;
  }
  .post-card__title {
    font-family: 'Fraunces', serif;
    font-size: clamp(20px, 2.5vw, 28px);
    font-weight: 500;
    letter-spacing: -0.5px;
  }
  .post-card__excerpt {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 640px;
  }
  .post-card__link {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    margin-top: 4px;
  }
</style>
