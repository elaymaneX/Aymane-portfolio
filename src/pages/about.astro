---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — Aymane Elamrani" activePage="About">
  <section class="container about-hero">
    <div class="about-photo-col">
      <div class="about-photo-frame">
        <img src="/images/about.jpeg" alt="Aymane in Cadaqués" class="about-photo" />
      </div>
    </div>
    <div class="about-text-col">
      <p class="about-label">About me</p>
      <h1 class="about-title">Hey, I'm <span class="highlight-blue">Aymane</span></h1>
      <div class="about-bio">
        <p>I'm an ML engineer based in Spain with a background in quantum physics and a deep interest in how AI agents will reshape the way we work and build software.</p>
        <p>My days are split between building AI-powered tools, writing about quantitative finance, and exploring the frontier of agentic systems. I studied physics, which gave me a taste for first-principles thinking and a healthy respect for uncertainty.</p>
        <p>When I'm not coding, you'll find me reading about macro-economics, experimenting with automation workflows, or planning my next trip along the Mediterranean coast.</p>
      </div>
    </div>
  </section>

  <section class="container about-details">
    <div class="detail-block">
      <h2 class="detail-title">What I work with</h2>
      <div class="skill-tags">
        <span class="skill-tag">Python</span>
        <span class="skill-tag">JAX</span>
        <span class="skill-tag">LangGraph</span>
        <span class="skill-tag">n8n</span>
        <span class="skill-tag">TypeScript</span>
        <span class="skill-tag">Astro</span>
        <span class="skill-tag">React</span>
        <span class="skill-tag">SQL</span>
        <span class="skill-tag">Docker</span>
        <span class="skill-tag">GCP</span>
      </div>
    </div>

    <div class="detail-block">
      <h2 class="detail-title">Interests</h2>
      <div class="interests-grid">
        <div class="interest">
          <span class="interest-icon">🤖</span>
          <div>
            <strong>Agentic AI</strong>
            <p>Multi-agent systems, tool-calling architectures, and the future of autonomous software.</p>
          </div>
        </div>
        <div class="interest">
          <span class="interest-icon">📊</span>
          <div>
            <strong>Quantitative Finance</strong>
            <p>Portfolio optimization, Monte Carlo methods, and algorithmic approaches to markets.</p>
          </div>
        </div>
        <div class="interest">
          <span class="interest-icon">🔬</span>
          <div>
            <strong>Scientific Computing</strong>
            <p>Physics-informed neural nets, numerical simulation, and computational methods.</p>
          </div>
        </div>
        <div class="interest">
          <span class="interest-icon">⚡</span>
          <div>
            <strong>Automation</strong>
            <p>Workflow automation with n8n, scripting repetitive tasks, and building personal infrastructure.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container cta-section">
    <div class="cta-box">
      <h2 class="cta-box__title">Let's connect</h2>
      <p class="cta-box__desc">Want to collaborate on a project, chat about AI, or just say hello? I'm always happy to hear from interesting people.</p>
      <a href="mailto:aelamra25@gmail.com" class="btn btn--accent">Get in touch →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    padding-top: 80px;
    padding-bottom: 60px;
    display: flex;
    gap: 64px;
    align-items: flex-start;
    flex-wrap: wrap;
  }
  .about-photo-col { flex: 0 0 360px; }
  .about-photo-frame {
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 3 / 4;
  }
  .about-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about-text-col { flex: 1 1 400px; min-width: 0; }
  .about-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 16px;
  }
  .about-title {
    font-family: 'Fraunces', serif;
    font-size: 48px;
    font-weight: 500;
    letter-spacing: -1px;
    margin-bottom: 24px;
  }
  .about-bio p {
    font-size: 16px;
    line-height: 1.8;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .about-details { padding-bottom: 80px; }
  .detail-block { margin-bottom: 56px; }
  .detail-title {
    font-family: 'Fraunces', serif;
    font-size: 32px;
    font-weight: 500;
    margin-bottom: 24px;
  }

  .skill-tags { display: flex; gap: 10px; flex-wrap: wrap; }
  .skill-tag {
    padding: 8px 20px;
    background: var(--card-bg);
    border-radius: 9999px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
  }

  .interests-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .interest {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    background: var(--card-bg);
    border-radius: 16px;
    padding: 28px;
  }
  .interest-icon { font-size: 28px; flex-shrink: 0; }
  .interest strong {
    display: block;
    margin-bottom: 6px;
    font-family: 'Fraunces', serif;
    font-size: 18px;
  }
  .interest p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .cta-section { padding-bottom: 80px; }
  .cta-box {
    background: var(--text);
    border-radius: 24px;
    padding: 64px;
    text-align: center;
    color: var(--bg);
  }
  .cta-box__title {
    font-family: 'Fraunces', serif;
    font-size: 40px;
    font-weight: 500;
    margin-bottom: 16px;
  }
  .cta-box__desc {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 480px;
    margin: 0 auto 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 15px;
    border: none;
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
  }
  .btn--accent { background: var(--accent); color: #fff; }

  @media (max-width: 768px) {
    .about-hero {
      flex-direction: column;
      gap: 32px;
      padding-top: 40px;
    }
    .about-photo-col { flex: 1 1 100%; max-width: 280px; margin: 0 auto; }
    .about-text-col { text-align: center; }
    .about-title { font-size: 36px; }
    .interests-grid { grid-template-columns: 1fr; }
    .cta-box { padding: 40px 24px; }
    .cta-box__title { font-size: 28px; }
  }
</style>
