---
import BaseLayout from '../layouts/BaseLayout.astro';

const experience = [
  {
    role: 'Research Intern',
    company: 'CVBLabs, UPV',
    period: 'Mar 2026 - Sep 2026',
    color: '#D32F2F',
    logo: 'upv',
    bullets: [
      'Designed and validated an optical simulation (FDTD + Mie theory): virtual test bench definition and experimental result interpretation.',
      'Built a Python pipeline for synthetic data generation and signal acquisition to train inverse models at scale.',
      'Used Docker to isolate execution environments and test model versions in parallel; Git-based version control in a shared repository.',
    ],
  },
  {
    role: 'Strategy Consultant / Data Science',
    company: 'Oliver Wyman, HackatOW',
    period: 'Feb 2025 - May 2025',
    color: '#00205B',
    logo: 'ow',
    bullets: [
      'Built a churn prediction model (XGBoost + logistic regression) achieving 80% precision and recall.',
      'Designed a data-driven retention strategy (€35k budget, 91.8% ROI).',
      'Winner of a selective pan-European challenge, first place against teams from top EU universities.',
    ],
  },
  {
    role: 'Business Intelligence Engineer, Intern',
    company: 'Amazon',
    period: 'Aug 2023 - Feb 2024',
    color: '#FF9900',
    logo: 'amazon',
    bullets: [
      'Built end-to-end ETL pipelines (Python, SQL, Amazon Redshift) to integrate and process logistics data at European scale.',
      'Developed real-time executive dashboards (Amazon QuickSight) to monitor transport KPIs, capacity, and route performance.',
      'Automated weekly logistics planning with Python scripts, achieving 98% scheduling accuracy and eliminating €500k in annual operational waste.',
    ],
  },
  {
    role: 'Data Manager',
    company: 'MAHLE Electronics',
    period: 'Jul 2022 - Sep 2022',
    color: '#C41230',
    logo: 'mahle',
    bullets: [
      'Managed the migration of legacy ETL processes to SAP, ensuring data integrity across systems.',
      'Coordinated data flows between departments during the transition period.',
    ],
  },
];

const education = [
  {
    degree: 'MSc in Quantum Information & Photonics',
    institution: 'Universitat Politècnica de València (UPV)',
    period: 'Sep 2025 - 2026',
    grade: '8/10',
    detail: 'Thesis: Physics-Informed Deep Learning for Quantitative Reconstruction in OCT',
  },
  {
    degree: 'Double BSc in Computer Science & Business Management',
    institution: 'Universitat Politècnica de València (UPV)',
    period: 'Sep 2019 - Jul 2025',
    grade: '9.9/10, Highest Honors',
    detail: 'Theses: Real-Time Sign Language to Speech Translation; Amazon Elderly data-driven marketing strategy (8.5/10)',
  },
];

const languages = [
  { name: 'Arabic', level: 'Native', percent: 100, flag: '🇲🇦' },
  { name: 'French', level: 'Bilingual', percent: 95, flag: '🇫🇷' },
  { name: 'Spanish', level: 'Bilingual', percent: 95, flag: '🇪🇸' },
  { name: 'English', level: 'C1', percent: 85, flag: '🇬🇧' },
];

const skillGroups = [
  { label: 'Languages', items: ['Python', 'Java', 'SQL', 'C', 'C++', 'MATLAB'] },
  { label: 'ML / AI', items: ['PyTorch', 'JAX', 'TensorFlow', 'Scikit-learn', 'XGBoost', 'LangChain', 'Anthropic API'] },
  { label: 'Backend', items: ['FastAPI', 'Node.js', 'Spring', 'REST APIs'] },
  { label: 'Frontend', items: ['Astro', 'React', 'TypeScript', 'HTML/CSS'] },
  { label: 'Data & BI', items: ['Pandas', 'NumPy', 'Redshift', 'Power BI', 'Tableau', 'QuickSight'] },
  { label: 'DevOps', items: ['Docker', 'Kubernetes', 'GCP', 'AWS', 'CI/CD', 'Git'] },
];
---

<BaseLayout title="About | Aymane Elamrani" activePage="About">
  <!-- HERO -->
  <section class="container about-hero">
    <div class="about-photo-col">
      <div class="about-photo-frame">
        <img src="/images/about.jpeg" alt="Aymane in Cadaqués" class="about-photo" />
      </div>
    </div>
    <div class="about-text-col">
      <p class="about-label">About me</p>
      <h1 class="about-title">Hey, I'm <span class="highlight-blue">Aymane</span></h1>
      <div class="about-bio">
        <p>Software Engineer with a double degree in Computer Science and Business, plus a master's in Quantum Information & Photonics from UPV Valencia. I've built ETL pipelines and dashboards at Amazon, won a pan-European data science challenge with Oliver Wyman, and done physics-informed ML research in optical imaging.</p>
        <p>Now I'm carving my way into quantitative finance and agentic AI, applying the same mathematical rigor to markets and autonomous systems. I like hard problems, messy data, and first-principles thinking.</p>
        <p><a href="mailto:aelamra25@gmail.com" class="help-link">How can I help you?</a></p>
      </div>
    </div>
  </section>

  <!-- EXPERIENCE -->
  <section class="container about-section">
    <h2 class="section-heading">Experience</h2>
    <div class="timeline">
      {experience.map((exp) => (
        <div class="timeline-item">
          <div class="timeline-logo" style={`border-color: ${exp.color}`}>
            {exp.logo === 'amazon' && (
              <svg viewBox="0 0 80 24" width="56" height="17" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M49.5 18.8c-4.6 3.4-11.3 5.2-17 5.2-8 0-15.3-3-20.8-8-.4-.4 0-.9.5-.6 5.9 3.5 13.2 5.5 20.8 5.5 5.1 0 10.7-1.1 15.8-3.3.8-.3 1.4.5.7 1.2z" fill="#FF9900"/>
                <path d="M51.4 16.6c-.6-.7-3.8-.4-5.3-.2-.4.1-.5-.3-.1-.6 2.6-1.8 6.8-1.3 7.3-.7.5.6-.1 5-2.5 7.1-.4.3-.7.2-.5-.3.5-1.3 1.7-4.5 1.1-5.3z" fill="#FF9900"/>
                <path d="M46.2 2.6V.8c0-.3.2-.5.5-.5h8.5c.3 0 .5.2.5.5v1.6c0 .3-.2.6-.6 1.1l-4.4 6.3c1.6 0 3.4.2 4.8 1 .3.2.4.5.4.8v2c0 .3-.3.6-.6.5-2.7-1.4-6.3-1.6-9.3 0-.3.2-.6-.2-.6-.5v-1.9c0-.3 0-.9.3-1.4l5.1-7.3h-4.4c-.3 0-.5-.2-.5-.5z" fill="var(--text)"/>
                <path d="M16.2 14.2h-2.6c-.2 0-.4-.2-.4-.4V.8c0-.3.2-.5.5-.5h2.4c.3 0 .4.2.5.4v1.8h.1c.6-1.7 1.8-2.5 3.4-2.5 1.6 0 2.7.8 3.4 2.5.6-1.7 2-2.5 3.5-2.5 1.1 0 2.2.4 2.9 1.4.8 1.1.6 2.6.6 4l-.1 8.3c0 .3-.2.5-.5.5h-2.6c-.3 0-.4-.2-.4-.5V5.9c0-.5 0-1.8-.1-2.3-.2-.8-.7-1.1-1.4-1.1-.6 0-1.2.4-1.5 1-.2.6-.2 1.6-.2 2.3v7.8c0 .3-.2.5-.5.5h-2.6c-.3 0-.4-.2-.4-.5l-.1-7.8c0-1.4.2-3.4-1.5-3.4-1.7 0-1.6 2-1.6 3.4v7.8c0 .3-.2.5-.5.5z" fill="var(--text)"/>
                <path d="M60.8.1c3.8 0 5.9 3.3 5.9 7.4 0 4-2.3 7.2-5.9 7.2-3.7 0-5.8-3.3-5.8-7.3S57.2.1 60.8.1zm0 2.7c-1.9 0-2 2.6-2 4.2 0 1.6 0 4.9 2 4.9s2.1-2.7 2.1-4.3c0-1.1 0-2.4-.3-3.4-.3-.9-.8-1.4-1.8-1.4z" fill="var(--text)"/>
                <path d="M71.2 14.2h-2.6c-.3 0-.4-.2-.4-.5l-.1-12.9c0-.3.2-.5.5-.5h2.4c.2 0 .4.2.5.4v2h.1c.7-1.8 1.7-2.7 3.5-2.7 1.1 0 2.3.4 3 1.5.7 1 .7 2.7.7 4v8.3c0 .3-.2.4-.5.4h-2.6c-.2 0-.4-.2-.4-.4V5.7c0-1.4.2-3.3-1.5-3.3-.6 0-1.1.4-1.4 1-.3.8-.4 1.5-.4 2.3v8c-.1.3-.3.5-.6.5z" fill="var(--text)"/>
                <path d="M40.7 8c0 1 0 1.8-.5 2.6-.4.7-1 1.1-1.6 1.1-1 0-1.5-.7-1.5-1.8 0-2.1 1.9-2.5 3.6-2.5V8zm2.4 5.9c-.2.1-.4.2-.5.1-.8-.6-.9-1.1-1.3-1.8-1.3 1.3-2.2 1.7-3.8 1.7-2 0-3.5-1.2-3.5-3.6 0-1.9 1-3.2 2.5-3.8 1.3-.5 3.1-.6 4.5-.8V5.5c0-.4 0-.9-.2-1.3-.2-.3-.7-.5-1.1-.5-.7 0-1.4.4-1.5 1.2-.1.3-.2.5-.4.5l-2.5-.3c-.2 0-.4-.2-.4-.5C35.2 1.7 37.8.3 40.6.3c1.4 0 3.2.4 4.3 1.4 1.4 1.3 1.3 3 1.3 4.9v4.4c0 1.3.5 1.9 1 2.6.2.3.2.6 0 .8-.5.5-1.5 1.3-2.1 1.8z" fill="var(--text)"/>
                <path d="M7.4 8c0 1 0 1.8-.5 2.6-.4.7-1 1.1-1.7 1.1-.9 0-1.5-.7-1.5-1.8 0-2.1 1.9-2.5 3.7-2.5V8zm2.4 5.9c-.2.1-.4.2-.5.1-.8-.6-.9-1.1-1.3-1.8-1.3 1.3-2.2 1.7-3.8 1.7-2 0-3.5-1.2-3.5-3.6C.7 8.4 1.7 7.1 3.2 6.5c1.3-.5 3.1-.6 4.5-.8V5.5c0-.4 0-.9-.2-1.3-.2-.3-.7-.5-1.1-.5-.7 0-1.4.4-1.5 1.2-.1.3-.2.5-.4.5L1.9 5c-.2 0-.4-.2-.4-.5C1.9 1.7 4.5.3 7.3.3c1.4 0 3.2.4 4.3 1.4 1.4 1.3 1.3 3 1.3 4.9v4.4c0 1.3.5 1.9 1 2.6.2.3.2.6 0 .8-.5.5-1.5 1.3-2.1 1.8z" fill="var(--text)"/>
              </svg>
            )}
            {exp.logo === 'ow' && (
              <span class="logo-text" style={`color: ${exp.color}; font-weight: 700; font-size: 11px; letter-spacing: -0.2px; text-align: center; line-height: 1.2;`}>OLIVER<br/>WYMAN</span>
            )}
            {exp.logo === 'upv' && (
              <span class="logo-text" style={`color: ${exp.color}; font-weight: 700; font-size: 13px; letter-spacing: 0.5px;`}>UPV</span>
            )}
            {exp.logo === 'mahle' && (
              <span class="logo-text" style={`color: ${exp.color}; font-weight: 700; font-size: 11px; letter-spacing: 0.5px;`}>MAHLE</span>
            )}
          </div>
          <div class="timeline-content">
            <div class="timeline-header">
              <div>
                <h3 class="timeline-role">{exp.role}</h3>
                <p class="timeline-company">{exp.company}</p>
              </div>
              <span class="timeline-period">{exp.period}</span>
            </div>
            <ul class="timeline-bullets">
              {exp.bullets.map(b => <li>{b}</li>)}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- EDUCATION -->
  <section class="container about-section">
    <h2 class="section-heading">Education</h2>
    <div class="edu-grid">
      {education.map(ed => (
        <div class="edu-card">
          <div class="edu-card__top">
            <h3 class="edu-degree">{ed.degree}</h3>
            <span class="edu-period">{ed.period}</span>
          </div>
          <p class="edu-institution">{ed.institution}</p>
          <p class="edu-grade">Grade: {ed.grade}</p>
          <p class="edu-detail">{ed.detail}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- SKILLS -->
  <section class="container about-section">
    <h2 class="section-heading">Technical Skills</h2>
    <div class="skills-grid">
      {skillGroups.map(group => (
        <div class="skill-group">
          <h3 class="skill-group__label">{group.label}</h3>
          <div class="skill-tags">
            {group.items.map(item => (
              <span class="skill-tag">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- LANGUAGES -->
  <section class="container about-section">
    <h2 class="section-heading">Languages</h2>
    <div class="languages-grid">
      {languages.map(lang => (
        <div class="lang-card">
          <div class="lang-card__head">
            <span class="lang-flag">{lang.flag}</span>
            <div>
              <span class="lang-name">{lang.name}</span>
              <span class="lang-level">{lang.level}</span>
            </div>
          </div>
          <div class="lang-bar">
            <div class="lang-bar__fill" style={`width: ${lang.percent}%`}></div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- INTERESTS -->
  <section class="container about-section">
    <h2 class="section-heading">Interests</h2>
    <div class="interests-grid">
      <div class="interest">
        <span class="interest-icon">🤖</span>
        <div>
          <strong>Agentic AI</strong>
          <p>Multi-agent systems, tool-calling architectures, and the future of autonomous software.</p>
        </div>
      </div>
      <div class="interest">
        <span class="interest-icon">📊</span>
        <div>
          <strong>Quantitative Finance</strong>
          <p>Portfolio optimization, Monte Carlo methods, and algorithmic approaches to markets.</p>
        </div>
      </div>
      <div class="interest">
        <span class="interest-icon">🔬</span>
        <div>
          <strong>Scientific Computing</strong>
          <p>Physics-informed neural nets, numerical simulation, and computational methods.</p>
        </div>
      </div>
      <div class="interest">
        <span class="interest-icon">⚡</span>
        <div>
          <strong>Automation</strong>
          <p>Workflow automation with n8n, scripting repetitive tasks, and building personal infrastructure.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container cta-section">
    <div class="cta-box">
      <h2 class="cta-box__title">Let's connect</h2>
      <p class="cta-box__desc">Want to collaborate on a project, chat about AI, or just say hello? I'm always happy to hear from interesting people.</p>
      <a href="mailto:aelamra25@gmail.com" class="btn btn--accent">Get in touch →</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .about-hero {
    padding-top: clamp(40px, 6vw, 80px);
    padding-bottom: clamp(40px, 5vw, 60px);
    display: flex;
    gap: clamp(32px, 5vw, 64px);
    align-items: flex-start;
    flex-wrap: wrap;
    justify-content: center;
  }
  .about-photo-col { flex: 0 0 clamp(220px, 28vw, 360px); }
  .about-photo-frame {
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 3 / 4;
  }
  .about-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about-text-col { flex: 1 1 320px; min-width: 0; }
  .about-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 16px;
  }
  .about-title {
    font-family: 'Fraunces', serif;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 500;
    letter-spacing: -1px;
    margin-bottom: 24px;
  }
  .about-bio p {
    font-size: 16px;
    line-height: 1.8;
    color: var(--text-muted);
    margin-bottom: 16px;
  }
  .help-link {
    color: var(--accent);
    font-weight: 600;
    font-size: 17px;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .help-link:hover { opacity: 0.8; }

  /* SECTIONS */
  .about-section {
    padding-bottom: clamp(48px, 6vw, 80px);
  }
  .section-heading {
    font-family: 'Fraunces', serif;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 500;
    margin-bottom: clamp(24px, 3vw, 40px);
    letter-spacing: -0.5px;
  }

  /* TIMELINE */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
    padding-left: 72px;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 28px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--border-light);
  }
  .timeline-item {
    position: relative;
    padding-bottom: 40px;
  }
  .timeline-item:last-child { padding-bottom: 0; }
  .timeline-logo {
    position: absolute;
    left: -72px;
    top: 0;
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: var(--card-bg);
    border: 2px solid;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
    overflow: hidden;
  }
  .logo-text {
    font-family: 'DM Sans', sans-serif;
    line-height: 1;
    user-select: none;
  }
  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }
  .timeline-role {
    font-family: 'Fraunces', serif;
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 500;
    letter-spacing: -0.3px;
  }
  .timeline-company {
    font-size: 14px;
    color: var(--text-muted);
    font-weight: 500;
    margin-top: 2px;
  }
  .timeline-period {
    font-size: 13px;
    color: var(--text-muted);
    background: var(--card-bg);
    padding: 4px 14px;
    border-radius: 9999px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .timeline-bullets {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .timeline-bullets li {
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-muted);
    padding-left: 16px;
    position: relative;
  }
  .timeline-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* EDUCATION */
  .edu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
  }
  .edu-card {
    background: var(--card-bg);
    border-radius: 16px;
    padding: clamp(24px, 3vw, 32px);
  }
  .edu-card__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }
  .edu-degree {
    font-family: 'Fraunces', serif;
    font-size: clamp(17px, 1.8vw, 20px);
    font-weight: 500;
  }
  .edu-period {
    font-size: 13px;
    color: var(--text-muted);
    background: var(--bg);
    padding: 3px 12px;
    border-radius: 9999px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .edu-institution {
    font-size: 14px;
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 8px;
  }
  .edu-grade {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 8px;
  }
  .edu-detail {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* SKILLS */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }
  .skill-group {
    background: var(--card-bg);
    border-radius: 16px;
    padding: clamp(20px, 2.5vw, 28px);
  }
  .skill-group__label {
    font-family: 'Fraunces', serif;
    font-size: 16px;
    font-weight: 500;
    margin-bottom: 14px;
    color: var(--accent);
  }
  .skill-tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .skill-tag {
    padding: 5px 14px;
    background: var(--bg);
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
  }

  /* LANGUAGES */
  .languages-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
  }
  .lang-card {
    background: var(--card-bg);
    border-radius: 16px;
    padding: clamp(20px, 2.5vw, 28px);
  }
  .lang-card__head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }
  .lang-flag {
    font-size: 28px;
    line-height: 1;
  }
  .lang-name {
    font-weight: 600;
    font-size: 15px;
    display: block;
  }
  .lang-level {
    font-size: 13px;
    color: var(--text-muted);
  }
  .lang-bar {
    height: 6px;
    background: var(--bg);
    border-radius: 3px;
    overflow: hidden;
  }
  .lang-bar__fill {
    height: 100%;
    background: var(--accent);
    border-radius: 3px;
    transition: width 0.6s ease;
  }

  /* INTERESTS */
  .interests-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }
  .interest {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    background: var(--card-bg);
    border-radius: 16px;
    padding: clamp(20px, 2.5vw, 28px);
  }
  .interest-icon { font-size: 28px; flex-shrink: 0; }
  .interest strong {
    display: block;
    margin-bottom: 6px;
    font-family: 'Fraunces', serif;
    font-size: 18px;
  }
  .interest p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* CTA */
  .cta-section { padding-bottom: clamp(40px, 6vw, 80px); }
  .cta-box {
    background: var(--text);
    border-radius: 24px;
    padding: clamp(32px, 5vw, 64px);
    text-align: center;
    color: var(--bg);
  }
  .cta-box__title {
