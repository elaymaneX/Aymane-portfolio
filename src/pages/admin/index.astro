---
// Admin panel: sign-in, comments, newsletter, posts and projects. Everything renders in the
// browser from /api/admin/*; this page itself holds no data. Kept out of search (meta, headers, sitemap).
import '../../styles/global.css';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Admin | Aymane</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <script is:inline>
    try {
      const saved = localStorage.getItem('theme');
      if (saved) document.documentElement.setAttribute('data-theme', saved);
      else if (matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.setAttribute('data-theme', 'dark');
    } catch (e) {}
  </script>
</head>
<body class="admin">
  <div id="app" aria-live="polite"><p class="admin-loading">Loading…</p></div>
  <script>import '../../scripts/admin.ts';</script>
</body>
</html>

<style is:global>
  .admin { min-height: 100vh; font-size: 15px; }
  .admin-loading { padding: 40px; color: var(--text-muted); }
  .admin button, .admin input, .admin select, .admin textarea { font: inherit; color: inherit; }

  /* Sign-in and setup */
  .auth {
    max-width: 380px;
    margin: 12vh auto 40px;
    padding: 0 20px;
  }
  .auth__brand { font-family: 'Fraunces', serif; font-size: 26px; font-weight: 640; letter-spacing: -0.03em; }
  .auth__brand span { color: var(--accent); }
  .auth h1 {
    font-family: 'Fraunces', serif;
    font-size: 40px;
    font-weight: 400;
    letter-spacing: -0.03em;
    margin: 28px 0 8px;
  }
  .auth h1 em { font-weight: 300; }
  .auth p.hint { color: var(--text-muted); font-size: 14px; line-height: 1.6; margin-bottom: 24px; }
  .auth form { display: grid; gap: 14px; }
  .auth__or { text-align: center; color: var(--text-muted); font-size: 13px; margin: 18px 0; }

  /* Form controls */
  .field { display: grid; gap: 6px; }
  .field > span { font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); }
  .field input, .field select, .field textarea {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 11px 12px;
  }
  .field textarea { resize: vertical; line-height: 1.6; }
  .field input:focus, .field select:focus, .field textarea:focus { outline: none; border-color: var(--text); }
  .field small { color: var(--text-muted); font-size: 12px; }
  .check { display: flex; align-items: center; gap: 8px; font-size: 14px; }
  .check input { width: 16px; height: 16px; accent-color: var(--text); }

  .a-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 18px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--text);
    background: var(--text);
    color: var(--bg) !important;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    white-space: nowrap;
  }
  .a-btn:hover { background: var(--accent); border-color: var(--accent); color: #fff !important; }
  .a-btn:disabled { opacity: 0.55; cursor: default; }
  .a-btn--ghost { background: transparent; color: var(--text) !important; }
  .a-btn--ghost:hover { background: var(--text); border-color: var(--text); color: var(--bg) !important; }
  .a-btn--danger { background: transparent; color: #DC2626 !important; border-color: #DC2626; }
  .a-btn--danger:hover { background: #DC2626; border-color: #DC2626; color: #fff !important; }
  .a-btn--sm { padding: 6px 11px; font-size: 13px; }
  .status { min-height: 20px; font-size: 14px; color: #DC2626; }
  .status--ok { color: #16A34A; }

  /* Shell: sidebar + main */
  .shell { display: grid; grid-template-columns: 230px minmax(0, 1fr); min-height: 100vh; }
  .side {
    border-right: 1px solid var(--border-light);
    padding: 28px 20px;
    display: flex;
    flex-direction: column;
    gap: 28px;
    position: sticky;
    top: 0;
    height: 100vh;
  }
  .side__brand { font-family: 'Fraunces', serif; font-size: 22px; font-weight: 640; letter-spacing: -0.03em; }
  .side__brand span { color: var(--accent); }
  .side__brand small { display: block; font-family: 'DM Sans', sans-serif; font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); margin-top: 4px; }
  .side nav { display: grid; gap: 2px; }
  .side nav a {
    display: flex;
    justify-content: space-between;
    padding: 9px 10px;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-weight: 500;
  }
  .side nav a:hover { color: var(--text); background: var(--card-bg); }
  .side nav a.active { color: var(--text); background: var(--card-bg); }
  .side nav a .badge { font-size: 12px; font-weight: 700; color: var(--bg); background: var(--text); padding: 0 7px; border-radius: var(--radius-sm); }
  .side__foot { margin-top: auto; display: grid; gap: 8px; font-size: 14px; }
  .side__foot a, .side__foot button { color: var(--text-muted); background: none; border: none; text-align: left; padding: 0; cursor: pointer; }
  .side__foot a:hover, .side__foot button:hover { color: var(--text); }

  .main { padding: 40px clamp(20px, 4vw, 56px) 80px; max-width: 1100px; width: 100%; }
  .page-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 28px; }
  .page-head h1 { font-family: 'Fraunces', serif; font-size: clamp(32px, 4vw, 44px); font-weight: 400; letter-spacing: -0.03em; line-height: 1.05; }
  .page-head h1 em { font-weight: 300; }
  .page-head p { color: var(--text-muted); margin-top: 6px; }
  .actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .section-title { font-family: 'Fraunces', serif; font-size: 22px; font-weight: 400; margin: 36px 0 14px; }
  .muted { color: var(--text-muted); }
  .empty { color: var(--text-muted); padding: 18px 0; }

  /* Dashboard tiles */
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 16px; }
  .tile { border: 1px solid var(--border-light); border-radius: var(--radius); padding: 20px; display: grid; gap: 6px; color: var(--text); }
  .tile:hover { border-color: var(--text); color: var(--text); }
  .tile b { font-family: 'Fraunces', serif; font-size: 40px; font-weight: 400; letter-spacing: -0.03em; line-height: 1; }
  .tile span { font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }

  /* Lists */
  .rows { border-top: 1px solid var(--border-light); }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid var(--border-light);
  }
  .row__title { font-weight: 600; }
  .row__meta { font-size: 13px; color: var(--text-muted); margin-top: 3px; display: flex; gap: 10px; flex-wrap: wrap; }
  .pill { font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; padding: 2px 7px; border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text-muted); }
  .pill--dark { background: var(--text); border-color: var(--text); color: var(--bg); }
  .comment-card { border: 1px solid var(--border-light); border-radius: var(--radius); padding: 16px 18px; display: grid; gap: 10px; margin-bottom: 12px; }
  .comment-card p { white-space: pre-wrap; line-height: 1.6; overflow-wrap: anywhere; }

  /* Editor */
  .editor { display: grid; gap: 24px; }
  .panel { border: 1px solid var(--border-light); border-radius: var(--radius); padding: 20px; display: grid; gap: 16px; }
  .panel h2 { font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }
  .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; }
  .tabs { display: flex; gap: 0; border-bottom: 1px solid var(--border-light); }
  .tabs button {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 10px 16px;
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
  }
  .tabs button.active { color: var(--text); border-bottom-color: var(--text); }
  .body-input { font-family: ui-monospace, SFMono-Regular, Menlo, monospace !important; font-size: 13.5px !important; min-height: 420px; }
  .list-rows { display: grid; gap: 8px; }
  .list-row { display: flex; gap: 8px; align-items: center; }
  .list-row input { flex: 1; min-width: 0; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 8px 10px; }
  .sticky-bar {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    padding: 14px 0;
    margin-top: -14px;
    border-bottom: 1px solid var(--border-light);
  }

  @media (max-width: 820px) {
    .shell { grid-template-columns: 1fr; }
    .side { position: static; height: auto; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 12px 20px; padding: 16px 20px; border-right: none; border-bottom: 1px solid var(--border-light); }
    .side nav { display: flex; flex-wrap: wrap; gap: 2px; }
    .side__foot { margin-top: 0; display: flex; gap: 16px; }
    .main { padding-top: 24px; }
  }
</style>
