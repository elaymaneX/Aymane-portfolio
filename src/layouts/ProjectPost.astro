---
import BaseLayout from './BaseLayout.astro';
import ArticleExtras from '../components/ArticleExtras.astro';
import { formatDate, localePath, t, type Lang } from '../i18n';
import 'katex/dist/katex.min.css';

interface Props {
  slug: string;
  title: string;
  date: Date;
  tags: { label: string; accent?: boolean }[];
  excerpt: string;
  colabUrl?: string;
  repoUrl?: string;
  stats?: { value: string; label: string }[];
  gallery?: { image: string; title: string; caption?: string }[];
  lang: Lang;
  fallback?: boolean;
}

const { slug, title, date, tags, excerpt, colabUrl, repoUrl, stats = [], gallery = [], lang, fallback = false } = Astro.props;
const ui = t(lang).projects;
const formattedDate = formatDate(lang, date, { year: 'numeric', month: 'long', day: 'numeric' });
const jsonLd = {
  '@type': 'CreativeWork',
  name: title,
  description: excerpt,
  dateCreated: date.toISOString(),
  author: { '@id': new URL('/#person', Astro.site).href },
  image: new URL(`/og/projects/${slug}.png`, Astro.site).href,
  keywords: tags.map(tag => tag.label).join(', '),
  ...(repoUrl && { codeRepository: repoUrl }),
};
---

<BaseLayout title={`${title} | Aymane Elamrani`} description={excerpt} activePage="Projects" lang={lang}
  ogImage={`/og/projects/${slug}.png`} article={{ published: date }} jsonLd={jsonLd}>
  <ArticleExtras copy={t(lang).blog.copy} copied={t(lang).blog.copied} close={t(lang).blog.close} />
  <article class="container post">
    {fallback && <p class="post__notice">{t(lang).onlyInEnglish}</p>}
    <header class="post__header">
      <a href={localePath(lang, '/projects')} class="post__back">{ui.back}</a>
      <div class="post__meta">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        <div class="post__tags">
          {tags.map(tag => (
            <span class:list={['post__tag', { 'post__tag--accent': tag.accent }]}>{tag.label}</span>
          ))}
        </div>
      </div>
      <h1 class="post__title" lang={fallback ? 'en' : undefined}>{title}</h1>
      <p class="post__excerpt">{excerpt}</p>
      {(colabUrl || repoUrl) && (
        <div class="post__links">
          {colabUrl && <a href={colabUrl} target="_blank" rel="noopener noreferrer" class="post__link post__link--primary">{ui.openColab}</a>}
          {repoUrl && <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="post__link">{ui.viewCode}</a>}
        </div>
      )}
    </header>

    <div class="post__content" lang={fallback ? 'en' : undefined}>
      {stats.length > 0 && (
        <div class="stats-grid">
          {stats.map(stat => (
            <div class="stat-card">
              <span class="stat-value">{stat.value}</span>
              <span class="stat-label">{stat.label}</span>
            </div>
          ))}
        </div>
      )}

      <slot />

      {gallery.length > 0 && (
        <>
          <h2>{ui.results}</h2>
          <div class="results-gallery">
            {gallery.map(item => (
              <figure>
                <img src={item.image} alt={item.caption || item.title} loading="lazy" />
                <figcaption>
                  <strong>{item.title}</strong>
                  {item.caption}
                </figcaption>
              </figure>
            ))}
          </div>
        </>
      )}
    </div>

    <footer class="post__footer">
      <a href={localePath(lang, '/projects')} class="post__back">{ui.backAll}</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post__notice {
    font-size: 14px;
    color: var(--text-muted);
    background: var(--card-bg);
    border-radius: 10px;
    padding: 10px 14px;
    margin-bottom: 24px;
  }
  /* Solid reading column; the Greek background only shows in the side margins */
  .post {
    padding-top: 60px;
    padding-bottom: 80px;
    max-width: 920px;
    background: var(--bg);
    box-shadow: 0 0 48px 24px var(--bg);
  }

  .post__back {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    display: inline-block;
    margin-bottom: 32px;
  }

  .post__meta {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }
  .post__meta time {
    font-size: 14px;
    color: var(--text-muted);
    font-weight: 500;
  }
  .post__tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .post__tag {
    font-size: 12px;
    padding: 3px 12px;
    background: var(--card-bg);
    border-radius: 9999px;
    color: var(--text-muted);
  }
  .post__tag--accent {
    background: var(--accent);
    color: #fff;
    font-weight: 600;
  }

  .post__title {
    font-family: 'Fraunces', serif;
    font-size: 44px;
    font-weight: 500;
    letter-spacing: -1.5px;
    line-height: 1.15;
    margin-bottom: 20px;
  }

  .post__excerpt {
    font-size: 18px;
    line-height: 1.7;
    color: var(--text-muted);
    padding-bottom: 32px;
  }
  .post__header {
    border-bottom: 1px solid var(--border-light);
    margin-bottom: 40px;
  }
  .post__links {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 32px;
  }
  .post__link {
    padding: 10px 20px;
    border-radius: 9999px;
    font-size: 14px;
    font-weight: 600;
    border: 1.5px solid var(--border);
    color: var(--text);
  }
  .post__link--primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .post__link:hover { opacity: 0.85; color: var(--text); }
  .post__link--primary:hover { color: #fff; }

  .post__content {
    font-size: 17px;
    line-height: 1.85;
    color: var(--text);
  }
  .post__content :global(h2) {
    font-family: 'Fraunces', serif;
    font-size: 28px;
    font-weight: 500;
    margin-top: 48px;
    margin-bottom: 16px;
    letter-spacing: -0.5px;
  }
  .post__content :global(h3) {
    font-family: 'Fraunces', serif;
    font-size: 22px;
    font-weight: 500;
    margin-top: 36px;
    margin-bottom: 12px;
  }
  .post__content :global(p) {
    margin-bottom: 20px;
  }
  .post__content :global(strong) {
    font-weight: 600;
  }
  .post__content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .post__content :global(ul),
  .post__content :global(ol) {
    margin-bottom: 20px;
    padding-left: 24px;
  }
  .post__content :global(li) {
    margin-bottom: 8px;
  }
  .post__content :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 20px;
    margin: 24px 0;
    color: var(--text-muted);
    font-style: italic;
  }
  .post__content :global(code) {
    font-size: 0.9em;
    background: var(--card-bg);
    padding: 2px 6px;
    border-radius: 4px;
  }
  .post__content :global(pre) {
    background: var(--card-bg);
    padding: 20px 24px;
    border-radius: 12px;
    overflow-x: auto;
    margin: 24px 0;
    font-size: 14px;
    line-height: 1.6;
  }
  .post__content :global(pre code) {
    background: none;
    padding: 0;
  }

  /* Stats grid used in project MDX content */
  .post__content :global(.stats-grid) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin: 24px 0;
  }
  .post__content :global(.stat-card) {
    background: var(--card-bg);
    border-radius: 12px;
    padding: 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .post__content :global(.stat-value) {
    font-family: 'Fraunces', serif;
    font-size: clamp(22px, 2.5vw, 30px);
    font-weight: 600;
    color: var(--accent);
  }
  .post__content :global(.stat-label) {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* Figures in the write-up; charts are exported on white, so they sit on a white card in both themes */
  .post__content :global(figure) {
    margin: 32px 0;
  }
  .post__content :global(figure img) {
    display: block;
    width: 100%;
    height: auto;
    background: #fff;
    border-radius: 12px;
    border: 1px solid var(--border-light);
    padding: 8px;
  }
  .post__content :global(figcaption) {
    margin-top: 10px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-muted);
    font-style: italic;
  }

  /* Results gallery used in project MDX content */
  .post__content :global(.results-gallery) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin: 24px 0;
  }
  .post__content :global(.results-gallery figure) {
    margin: 0;
    border-radius: 12px;
    overflow: hidden;
    background: var(--card-bg);
  }
  .post__content :global(.results-gallery img) {
    width: 100%;
    height: auto;
    display: block;
  }
  .post__content :global(.results-gallery figcaption) {
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .post__content :global(.results-gallery figcaption strong) {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
  }
  .post__content :global(.results-gallery figcaption) {
    font-size: 12px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .post__footer {
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--border-light);
  }

  @media (max-width: 768px) {
    .post { padding-top: 32px; }
    .post__title { font-size: 32px; }
    .post__content :global(.stats-grid) { grid-template-columns: 1fr; }
    .post__content :global(.results-gallery) { grid-template-columns: 1fr; }
  }
</style>
