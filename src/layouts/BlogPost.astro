---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date: Date;
  tag: string;
  tagColor: string;
  excerpt: string;
}

const { title, date, tag, tagColor, excerpt } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={`${title} | Aymane Elamrani`} description={excerpt} activePage="Blog">
  <article class="container post">
    <header class="post__header">
      <a href="/blog" class="post__back">← Back to blog</a>
      <div class="post__meta">
        <time>{formattedDate}</time>
        <span class="post__tag" style={`background: ${tagColor}`}>{tag}</span>
      </div>
      <h1 class="post__title">{title}</h1>
      <p class="post__excerpt">{excerpt}</p>
    </header>

    <div class="post__content">
      <slot />
    </div>

    <footer class="post__footer">
      <a href="/blog" class="post__back">← Back to all posts</a>
    </footer>
  </article>
</BaseLayout>

<style>
  /* Solid reading column; the Greek background only shows in the side margins */
  .post {
    padding-top: 60px;
    padding-bottom: 80px;
    max-width: 720px;
    background: var(--bg);
    box-shadow: 0 0 48px 24px var(--bg);
  }

  .post__back {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    display: inline-block;
    margin-bottom: 32px;
  }

  .post__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .post__meta time {
    font-size: 14px;
    color: var(--text-muted);
    font-weight: 500;
  }
  .post__tag {
    font-size: 12px;
    padding: 3px 12px;
    color: #fff;
    border-radius: 9999px;
    font-weight: 600;
  }

  .post__title {
    font-family: 'Fraunces', serif;
    font-size: 44px;
    font-weight: 500;
    letter-spacing: -1.5px;
    line-height: 1.15;
    margin-bottom: 20px;
  }

  .post__excerpt {
    font-size: 18px;
    line-height: 1.7;
    color: var(--text-muted);
    padding-bottom: 32px;
    border-bottom: 1px solid var(--border-light);
    margin-bottom: 40px;
  }

  .post__content {
    font-size: 17px;
    line-height: 1.85;
    color: var(--text);
  }
  .post__content :global(h2) {
    font-family: 'Fraunces', serif;
    font-size: 28px;
    font-weight: 500;
    margin-top: 48px;
    margin-bottom: 16px;
    letter-spacing: -0.5px;
  }
  .post__content :global(h3) {
    font-family: 'Fraunces', serif;
    font-size: 22px;
    font-weight: 500;
    margin-top: 36px;
    margin-bottom: 12px;
  }
  .post__content :global(p) {
    margin-bottom: 20px;
  }
  .post__content :global(strong) {
    font-weight: 600;
  }
  .post__content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .post__content :global(ul),
  .post__content :global(ol) {
    margin-bottom: 20px;
    padding-left: 24px;
  }
  .post__content :global(li) {
    margin-bottom: 8px;
  }
  .post__content :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 20px;
    margin: 24px 0;
    color: var(--text-muted);
    font-style: italic;
  }
  .post__content :global(code) {
    font-size: 0.9em;
    background: var(--card-bg);
    padding: 2px 6px;
    border-radius: 4px;
  }
  .post__content :global(pre) {
    background: var(--card-bg);
    padding: 20px 24px;
    border-radius: 12px;
    overflow-x: auto;
    margin: 24px 0;
    font-size: 14px;
    line-height: 1.6;
  }
  .post__content :global(pre code) {
    background: none;
    padding: 0;
  }

  .post__footer {
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--border-light);
  }

  @media (max-width: 768px) {
    .post { padding-top: 32px; }
    .post__title { font-size: 32px; }
  }
</style>
