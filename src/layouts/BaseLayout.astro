---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import GreekBackground from '../components/GreekBackground.astro';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import headshot from '../assets/headshot.jpeg';
import Analytics from '@vercel/analytics/astro';
import { locales, localePath, t, unlocalizedPath, type Lang } from '../i18n';

interface Props {
  title: string;
  description?: string;
  activePage?: string;
  lang: Lang;
  // Share card for this page (see src/pages/og); defaults to the site card
  ogImage?: string;
  // Set for blog posts and project write-ups
  article?: { published: Date };
  // Extra schema.org data for search engines, added next to the Person entry
  jsonLd?: Record<string, unknown>;
}

const { title, lang, description = t(lang).meta.defaultDescription, activePage = '', article, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const basePath = unlocalizedPath(Astro.url.pathname);
const ogImage = new URL(Astro.props.ogImage ?? '/og/site.png', Astro.site);
const photo = new URL((await getImage({ src: headshot, width: 600, format: 'jpeg' })).src, Astro.site);

const person = {
  '@type': 'Person',
  '@id': new URL('/#person', Astro.site).href,
  name: 'Aymane Elamrani',
  url: new URL('/', Astro.site).href,
  image: photo.href,
  jobTitle: 'Quantitative Data Scientist and ML Engineer',
  email: 'mailto:aelamra25@gmail.com',
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universitat Politècnica de València' },
  sameAs: ['https://github.com/elaymaneX', 'https://www.linkedin.com/in/elam-aymane/'],
};
const structuredData = { '@context': 'https://schema.org', '@graph': [person, ...(jsonLd ? [jsonLd] : [])] };
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="canonical" href={canonical} />
  {locales.map(l => <link rel="alternate" hreflang={l} href={new URL(localePath(l, basePath), Astro.site)} />)}
  <link rel="alternate" hreflang="x-default" href={new URL(basePath, Astro.site)} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title="Aymane Elamrani" href="/rss.xml" />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  {article && <meta property="article:published_time" content={article.published.toISOString()} />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={{ en: 'en_US', es: 'es_ES', fr: 'fr_FR' }[lang]} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preload" href="/fonts/dm-sans-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/fraunces-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
  <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  <Analytics />
  <title>{title}</title>
  <script is:inline>
    // Prevent flash of wrong theme
    (function() {
      try {
        const saved = localStorage.getItem('theme');
        if (saved) { document.documentElement.setAttribute('data-theme', saved); }
        else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      } catch(e) {}
    })();
  </script>
  {lang === 'en' && (
    <script is:inline>
      // First visit only: send Spanish/French browsers to their language once.
      // Any choice made with the language switcher is remembered and wins.
      (function() {
        try {
          if (localStorage.getItem('lang')) return;
          const fromSite = document.referrer && new URL(document.referrer).origin === location.origin;
          const pref = (navigator.languages || [navigator.language]).map(l => l.slice(0, 2)).find(l => l === 'es' || l === 'fr' || l === 'en');
          localStorage.setItem('lang', pref || 'en');
          if (!fromSite && (pref === 'es' || pref === 'fr')) {
            location.replace('/' + pref + (location.pathname === '/' ? '/' : location.pathname) + location.search + location.hash);
          }
        } catch (e) {}
      })();
    </script>
  )}
</head>
<body>
  <!-- Grey-purple duotone shared by photos and logos (.duotone); same mapping as src/assets/hero-portrait.png -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <filter id="duotone" color-interpolation-filters="sRGB">
      <feColorMatrix type="matrix" values="0.299 0.587 0.114 0 0  0.299 0.587 0.114 0 0  0.299 0.587 0.114 0 0  0 0 0 1 0" />
      <feComponentTransfer>
        <feFuncR type="table" tableValues="0.094 0.173 0.290 0.406 0.523 0.639 0.756 0.872 0.957" />
        <feFuncG type="table" tableValues="0.063 0.143 0.262 0.381 0.499 0.618 0.736 0.855 0.941" />
        <feFuncB type="table" tableValues="0.204 0.277 0.384 0.492 0.599 0.707 0.814 0.922 1.000" />
      </feComponentTransfer>
    </filter>
  </svg>

  <a href="#main" class="skip-link">{t(lang).skipToContent}</a>
  <GreekBackground />
  <Nav activePage={activePage} lang={lang} />
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} />
  <script>
    // Fade-up for elements marked data-reveal; without JS (or with reduced motion) they simply show
    const revealed = document.querySelectorAll('[data-reveal]');
    if (revealed.length && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      }, { rootMargin: '0px 0px -10% 0px' });
      revealed.forEach(el => observer.observe(el));
      document.documentElement.classList.add('reveal-ready');
    }
  </script>
</body>
</html>
