# The site's public URL (sitemap, share cards, and the origin allowed to post to the API)
SITE_URL=https://aymaneelam.dev
# Upstash Redis for blog comments (/api/comments). Adding Upstash from the Vercel Marketplace
# sets KV_REST_API_URL / KV_REST_API_TOKEN automatically; without them, `npm run dev` keeps
# comments in memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Setup token for the admin panel (/admin): needed once to create the admin account.
# Use a long random value (32+ characters), e.g. the output of: openssl rand -hex 32
COMMENTS_ADMIN_TOKEN=
# Admin panel saves posts, projects and images to GitHub: a fine-grained token with
# "Contents: read and write" on this repository only. Without it, `npm run dev` edits local files.
GITHUB_TOKEN=
GITHUB_REPO=elaymaneX/Aymane-portfolio
GITHUB_BRANCH=main
# Newsletter (/api/subscribe): a Resend API key (Full access) and the id of the Resend segment
# that broadcasts go to (Audience > Segments). Without them, `npm run dev` accepts sign-ups
# without sending them anywhere.
RESEND_API_KEY=
RESEND_SEGMENT_ID=
