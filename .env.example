# GitHub OAuth app used by the Decap CMS login (/api/auth)
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# Optional: the site's public URL; only this origin receives the CMS token
SITE_URL=https://aymane-portofolio-eta.vercel.app
# Upstash Redis for blog comments (/api/comments). Adding Upstash from the Vercel Marketplace
# sets KV_REST_API_URL / KV_REST_API_TOKEN automatically; without them, `npm run dev` keeps
# comments in memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Password for /comments-admin, where new comments are approved before they appear.
# Use a long random value (32+ characters), e.g. the output of: openssl rand -hex 32
COMMENTS_ADMIN_TOKEN=
